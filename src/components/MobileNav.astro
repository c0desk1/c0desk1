---
// src/components/MobileNav.astro
import { NAV, SITE } from "../consts";
import Icon from "./ui/Icons.astro";
import Socials from "./Socials.astro";
import Theme from "./Theme.astro";
import Card from "./ui/Card.astro";

const currentPath = Astro.url.pathname;
const baseUrl = SITE.url.replace(/\/$/, "");

const links = [
  ...NAV.mobileNavBar.map((item) => {
    const isExternal = item.href.startsWith("http");
    const href = isExternal ? item.href : `${baseUrl}${item.href.endsWith('/') ? item.href : `${item.href}/`}`;
    return {
      label: item.label,
      href,
      icon: item.icon,
    };
  }),
];

const $ = {
  wrapper: "group/nav md:hidden relative select-none",
  trigger: [
    "block aspect-square items-center justify-center shrink-0 p-1 rounded-md",
    "text-(--fg-muted) hover:bg-(--bg-muted) active:bg-(--bg-muted)",
    "cursor-pointer list-none [&::-webkit-details-marker]:hidden"
  ].join(" "),
  triggerIcon: [
    "size-6 rotate-0",
    "hover:text-(--fg-strong) active:text-(--fg-strong)",
    "transition-transform duration-(--duration)",
    "group-open/nav:rotate-180",
  ].join(" "),
  backdrop: [
    "mobile-nav-backdrop",
    "fixed inset-x-0 bottom-0 top-[var(--header-height)] z-40",
    "bg-black/30 opacity-0 pointer-events-none",
    "transition-opacity duration-(--duration)",
    "group-open/nav:opacity-100 group-open/nav:pointer-events-auto",
  ].join(" "),
  panel: [
    "fixed left-0 right-0 top-[var(--header-height)] z-40",
    "bg-(--bg)/95 backdrop-blur-md rounded-b-lg border-b shadow-(--shadow-md) border-(--border)",
    "overscroll-contain"
  ].join(" "),
  panelWrapper: "px-2 py-3 space-y-2 gap-2",
  panelItem: [
    "mobile-nav-link",
    "flex gap-3 p-2 items-center text-body-14 font-medium",
    "hover:text-(--fg-strong) active:text-(--fg-strong)",
    "opacity-0 translate-y-full group-open/nav:opacity-100 group-open/nav:translate-0",
    "transition-[opacity,transform] duration-(--duration) ease-(--ease-out)"
  ].join(" "),
  panelPrefix: "inline-flex items-center justify-center size-5",
  panelFooter: "flex items-center justify-between items-center"
}
---

<details id="mobile-menu-details" class={$.wrapper}>
  <summary aria-label="Open menu" class={$.trigger}>
    <Icon id="mobile-chevron" name="chevron-down" class={$.triggerIcon} />
  </summary>

  <div class={$.backdrop} aria-hidden="true"></div>

  <div id="mobile-menu-panel" class={$.panel}>
    <nav class={$.panelWrapper}>
      {links.map((item, i) => {
        const cleanHref = item.href.replace(/\/$/, "");
        const cleanPath = currentPath.replace(/\/$/, "");
        const isActive = cleanPath === cleanHref;

        return (
          <a
            aria-label={item.label}
            href={item.href}
            style={`transition-delay: ${i * 30}ms`}
            class:list={[
              $.panelItem,
              isActive 
              ? "text-(--fg-strong)" 
              : "text-(--fg-muted)"
            ]}
          >
            <Icon name={item.icon as any} class={$.panelPrefix} />
            {item.label}
          </a>
        );
      })}
      <Card variant="outline" padding="xs" radius="sm" class="mt-4" style={`transition-delay: ${links.length * 30}ms`}>
        <div class={$.panelFooter}>
          <div class="flex items-center gap-1">
            <Socials />
          </div>
          <Theme />
        </div>
      </Card>
    </nav>
  </div>
</details>

<script>
  function initMobileNavDetails() {
    const details = document.getElementById("mobile-menu-details") as HTMLDetailsElement | null;
    if (!details) return;

    const links = details.querySelectorAll(".mobile-nav-link");
    const backdrop = details.querySelector(".mobile-nav-backdrop");

    function closeMenu() {
      details?.removeAttribute("open");
    }

    links.forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    backdrop?.addEventListener("click", closeMenu);

    const mq = window.matchMedia("(min-width: 768px)");
    mq.addEventListener("change", (e) => {
      if (e.matches) closeMenu();
    });

    document.addEventListener("click", (e) => {
      if (details.hasAttribute("open") && !details.contains(e.target as Node)) {
        closeMenu();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && details.hasAttribute("open")) {
        closeMenu();
        (details.querySelector("summary") as HTMLElement | null)?.focus();
      }
    });

    details.addEventListener("toggle", () => {
      if (details.open) {
        const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
        document.body.style.overflow = "hidden";
        if (scrollbarWidth > 0) document.body.style.paddingRight = `${scrollbarWidth}px`;
      } else {
        document.body.style.overflow = "";
        document.body.style.paddingRight = "";
      }
    });
  }

  initMobileNavDetails();
</script>
