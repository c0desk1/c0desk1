---
// src/components/ShareDropdown.astro
import Icon from "@ui/Icons.astro";

interface Props {
  label?: string;
  class?: string;
}

const { 
  label = "Bagikan", 
  class: className 
} = Astro.props;

const uniqueId = `share-dropdown-${Math.random().toString(36).substring(2, 9)}`;

const s = {
  wrapper: [
    'share-dropdown-wrapper',
    'relative inline-flex items-stretch rounded ring-1 shadow-(--shadow-sm)',
    'ring-(--border) bg-(--bg-subtle)',
    'transition-shadow duration-(--duration)'
  ].join(" "),

  actionGroup: [
    'flex items-center gap-1.5 text-button-13 md:text-button-14 text-(--fg-muted)',
    'hover:bg-(--bg-muted) hover:text-(--fg-strong)',
    'cursor-pointer select-none'
  ].join(" "),

  actionDivider: "h-px bg-(--border) my-1.5 mx-1",

  actionIcon: [
    'relative inline-flex items-center justify-center shrink-0',
    'size-4.5',
  ].join(" "),

  actionDropdown: [
    'absolute right-0 top-[calc(100%+0.5rem)] min-w-[12rem] z-40 rounded-md ring-1 p-1',
    'ring-(--border) bg-(--bg-subtle) shadow-(--shadow-lg)',
    'animate-in fade-in slide-in-from-top-2 origin-top-right',
  ].join(" "),
  
  actionDropdownItems: [
    'flex items-center gap-2 p-2 text-button-13 md:text-button-14 text-start rounded w-full',
    'text-(--fg) hover:bg-(--bg-muted) hover:text-(--fg-strong)',
    'cursor-pointer'
  ].join(" "),
}
---

<div class:list={[s.wrapper, className]}>
  
  <button 
    type="button"
    data-action="share-default" 
    aria-label="Bagikan Halaman"
    title={label}
    class:list={["px-2.5 py-2 rounded-l", s.actionGroup]}
  >
    <div class={s.actionIcon}>
      <Icon name="share" class="icon-share size-full" />
      <Icon name="check" class="icon-check size-full hidden absolute inset-0 text-(--accent) transition-opacity duration-(--duration)" />
    </div>
    <span>{label}</span>
  </button>

  <details 
    id={uniqueId}
    data-auto-close
    class="relative group"
  >
    <summary 
      title="Opsi lainnya"
      aria-label="Opsi lainnya" 
      class:list={[
        "p-2 rounded-r border-l border-(--border) h-full",
        "list-none flex items-center justify-center",
        s.actionGroup
      ]}
    >
      <div class={s.actionIcon}>
        <Icon name="chevron-down" class="size-full group-open:rotate-180 transition-transform" />
      </div>
    </summary>

    <div class={s.actionDropdown}>
      <button type="button" data-action="twitter" class={s.actionDropdownItems}>
        <Icon name="twitter" class={s.actionIcon} /> X (Twitter)
      </button>
      <button type="button" data-action="facebook" class={s.actionDropdownItems}>
        <Icon name="facebook" class={s.actionIcon} /> Facebook
      </button>
      <button type="button" data-action="linkedin" class={s.actionDropdownItems}>
        <Icon name="linkedin" class={s.actionIcon} /> LinkedIn
      </button>
      <button type="button" data-action="whatsapp" class={s.actionDropdownItems}>
        <Icon name="whatsapp" class={s.actionIcon} /> WhatsApp
      </button>
      <div class={s.actionDivider}></div>
      <button type="button" data-action="copy-url" class={s.actionDropdownItems}>
        <Icon name="link" class={s.actionIcon} /> Copy URL
      </button>
    </div>
  </details>
</div>

<script>
  function setupShareButton() {
    document.querySelectorAll('.share-dropdown-wrapper').forEach(wrapper => {
      const primaryBtn = wrapper.querySelector('[data-action="share-default"]');
      const details = wrapper.querySelector('details');
      const iconShare = wrapper.querySelector('.icon-share');
      const iconCheck = wrapper.querySelector('.icon-check');

      if (!primaryBtn || !details) return;

      const showCheckmark = () => {
        iconShare?.classList.add('hidden');
        iconCheck?.classList.remove('hidden');
        setTimeout(() => {
          iconShare?.classList.remove('hidden');
          iconCheck?.classList.add('hidden');
        }, 2000);
      };

      primaryBtn.addEventListener('click', async () => {
        const data = { title: document.title, url: window.location.href };
        if (navigator.share) {
          try { await navigator.share(data); } catch (err) { console.log(err); }
        } else {
          await navigator.clipboard.writeText(data.url);
          showCheckmark();
        }
      });

      details.querySelectorAll('button[data-action]').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const action = (e.currentTarget as HTMLElement).getAttribute('data-action');
          details.removeAttribute('open');

          if (action === 'copy-url') {
            await navigator.clipboard.writeText(window.location.href);
            showCheckmark();
          } else {
            const url = encodeURIComponent(window.location.href);
            const title = encodeURIComponent(document.title);
            const shareMap: Record<string, string> = {
              twitter: `https://twitter.com/intent/tweet?url=${url}&text=${title}`,
              facebook: `https://www.facebook.com/sharer/sharer.php?u=${url}`,
              linkedin: `https://www.linkedin.com/shareArticle?mini=true&url=${url}&title=${title}`,
              whatsapp: `https://api.whatsapp.com/send?text=${title}%20${url}`
            };
            if (shareMap[action as string]) window.open(shareMap[action as string], '_blank', 'noopener,noreferrer');
          }
        });
      });
    });

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      document.querySelectorAll('details[data-auto-close][open]').forEach(details => {
        if (details.hasAttribute('id') && !details.contains(target)) {
          details.removeAttribute('open');
        }
      });
    });
  }

  setupShareButton();
</script>