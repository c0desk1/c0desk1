---

<ol class="steps">
  <slot />
</ol>

<style is:global>
  .steps {
    counter-reset: step;
    padding: 0;
    list-style: none;
  }

  .steps > li {
    position: relative;
    counter-increment: step;
    min-height: 1.75rem;
    padding-inline-start: 2.5rem;
    padding-bottom: 1.25rem;
  }

  .steps > li::before {
    content: counter(step);
    position: absolute;
    inset-inline-start: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    
    width: 1.65rem;
    height: 1.65rem;
    aspect-ratio: 1/1;
    border-radius: var(--radius-full);
    border: 1.5px solid rgb(from var(--bg) r g b / 0.6);
    background-color: var(--bg-subtle);
    color: var(--fg-strong);
    box-shadow: 0 0 0 1.5px var(--bg-muted);
    padding: 0 !important;
  }

  .steps > li::after {
    content: "";
    position: absolute;
    inset-inline-start: 0.75rem;
    top: 2rem;
    bottom: 0;
    width: 1px;
    transform: translateX(-50%);
    border-left: 1px solid rgb(from var(--border) r g b / 0.5);
  }

  .steps > li:last-child::after {
    display: none;
  }

  .steps > li > :first-child {
    margin-top: 0 !important;
  }

  .steps > li > :last-child {
    margin-bottom: 0 !important;
  }

  .steps > li:last-child {
    padding-bottom: 0 !important;
  }
</style>
