---
// src/components/docs/LeftSidebar.astro
import SidebarMenu from "./SidebarMenu.astro";
import Sidebar from "@ui/Sidebar.astro";
import Drawer from "@ui/Drawer.astro";
import Card from "@ui/Card.astro";
import Socials from "@/components/Socials.astro";
import Theme from "@/components/Theme.astro";
---

<aside 
  aria-label="Main Navigation"
  class="hidden lg:block sticky top-(--header-height) h-[calc(100vh-var(--header-height))] w-full bg-(--bg) border-r border-(--border-subtle) scrollbar-gutter-stable overflow-y-auto"
>
  <Sidebar>
    <SidebarMenu />
  </Sidebar>
</aside>

<Drawer id="mobile-nav-drawer">
  <div class="flex flex-col h-full">
    <div class="flex-1 overflow-y-auto mb-0 scrollbar-gutter-stable">
      <SidebarMenu />
    </div>
    <Card padding="xs" radius="sm" variant="secondary" class="flex md:hidden items-center justify-between mt-4">
      <div class="flex items-center">
        <Socials />
      </div>
      <Theme />
    </Card>
  </div>
</Drawer>
