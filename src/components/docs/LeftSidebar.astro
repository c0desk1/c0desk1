---
// src/components/docs/LeftSidebar.astro
import SidebarMenu from "./SidebarMenu.astro";
import Socials from "@components/Socials.astro";
import Theme from "@components/Theme.astro";
import Card from "@ui/Card.astro";
import GithubStar from "@components/GithubStar.astro";
---

<input type="checkbox" id="mobile-nav-toggle" class="peer hidden" aria-hidden="true" />

<label 
  for="mobile-nav-toggle"
  class="fixed inset-0 z-30 hidden bg-(--bg)/80 backdrop-blur-sm lg:hidden peer-checked:block cursor-pointer"
><span class="sr-only">Tutup menu navigasi</span></label>

<aside 
  class={
    "fixed top-[calc(var(--header-height)+0)] inset-x-0 z-50 w-full h-[calc(100vh-var(--header-height))] bg-(--bg) border-b border-(--border-subtle) hidden " +
    "peer-checked:block " +
    "lg:block lg:border-b-0 lg:border-r lg:w-full lg:sticky lg:top-(--header-height) lg:z-0"
  }
>
  <div class="flex flex-col h-full">
    <div class="flex-1 overflow-y-auto pt-4 pb-4 lg:py-2 scrollbar-gutter-stable">
      <SidebarMenu />
    </div>

    <div class="shrink-0 p-4 lg:hidden pb-(--safe-bottom)">
      <Card variant="primary" padding="xs" radius="sm">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-1">
            <GithubStar repo="c0desk1" />
            <Socials />
          </div>
          <Theme />
        </div>
      </Card>
    </div>

  </div>
</aside>

<style is:global>
  body:has(#mobile-nav-toggle:checked) {
    overflow: hidden;
  }
</style>
