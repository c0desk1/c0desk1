---
// src/components/docs/DocsNavigation.astro
import { getCollection } from 'astro:content';
import { ROUTES } from '@/consts';
import { SIDEBAR_CONFIG } from '@/config/sidebar';
import SidebarGroup from '@/components/ui/SidebarGroup.astro';
import SidebarLink from '@/components/ui/SidebarLink.astro';

const allDocs = await getCollection('docs', ({ data }) => !data.draft);

const sortedDocs = [...allDocs].sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
const primaryRootId = sortedDocs[0]?.id;

const docsByCategory: Record<string, typeof allDocs> = {};
for (const doc of sortedDocs) {
  const category = doc.data.category || 'Uncategorized';
  if (!docsByCategory[category]) docsByCategory[category] = [];
  docsByCategory[category].push(doc);
}

// 🔥 Ambil daftar kategori dari config
const configCategories: string[] = SIDEBAR_CONFIG.map(c => c.category);
const availableCategories = Object.keys(docsByCategory);

const orderedCategories = configCategories.filter(cat => availableCategories.includes(cat));
const extraCategories = availableCategories.filter(cat => !configCategories.includes(cat));
const sortedCategories = [...orderedCategories, ...extraCategories];

const ungroupedDocs = sortedDocs.filter((doc) => !doc.data.category);

const currentPath = Astro.url.pathname;
const docsRootPath = `${ROUTES.docs}/`;

const checkIsActive = (href: string) => {
  if (href === docsRootPath) {
    return currentPath === ROUTES.docs || currentPath === docsRootPath;
  }
  return currentPath === href || currentPath === `${href}/`;
};

const getHref = (doc: (typeof allDocs)[number]) => {
  const finalSlug = doc.data.slug || doc.id.replace(/\.(md|mdx)$/, '');
  return doc.id === primaryRootId ? docsRootPath : `${ROUTES.docs}/${finalSlug}/`;
};

const getCategoryLabel = (category: string) => {
  const found = SIDEBAR_CONFIG.find(c => c.category === category);
  return found?.label || category;
};

const $ = {
  wrapper: "flex flex-col space-y-1 w-full flex-1 py-2 px-4",
}
---

<div class={$.wrapper}>
  {sortedCategories.map((category) => {
    const categoryDocs = docsByCategory[category] || [];
    const hasActiveChild = categoryDocs.some((doc) => checkIsActive(getHref(doc)));
    const label = getCategoryLabel(category as typeof SIDEBAR_CONFIG[number]['category']);
    
    return (
      <SidebarGroup title={label} open={hasActiveChild}>
        {categoryDocs.map((doc) => (
          <SidebarLink href={getHref(doc)} isActive={checkIsActive(getHref(doc))}>
            {doc.data.title}
          </SidebarLink>
        ))}
      </SidebarGroup>
    );
  })}

  {ungroupedDocs.map((doc) => (
    <SidebarLink 
      href={getHref(doc)} 
      isActive={checkIsActive(getHref(doc))} 
      grouped={false}
    >
      {doc.data.title}
    </SidebarLink>
  ))}
</div>
