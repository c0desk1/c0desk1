---
//src/ui/Logo.astro
import { 
    SITE, 
    ROUTES 
} from "@/consts";

import Button from "./Button.astro";
import L from "../../assets/images/c0desk1.svg"

interface Props {
  label?: boolean;
}

const { 
    label = true 
} = Astro.props;

const $ = {
    wrapper: "p-0! hover:bg-transparent! active:bg-transparent!",
    logo: "size-6 text-(--fg-strong)",
    label: "text-heading-24 font-semibold text-(--fg-strong)"
}
---
<Button
    href={ROUTES.home}
    aria-label={SITE.name}
    variant="ghost"
    size="lg"
    class={$.wrapper}>
    <L class={$.logo}/>
    {label && ( 
        <span class={$.label}>
            {SITE.name}
        </span> 
    )}
    <br />
</Button>
