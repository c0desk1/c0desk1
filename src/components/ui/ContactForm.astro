---
// src/components/ContactForm.astro
import Input from "./Input.astro"
import Textarea from "./Textarea.astro"
import Button from "./Button.astro"
import Icon from "./Icons.astro"
import Spinner from "./Spinner.astro"
import Card from "./Card.astro"
---

<div id="contact-container">
  <div id="success-message" class="hidden bg-elevated border border-(--border) rounded-xl p-12 text-center animate-in fade-in zoom-in-95 duration-300 shadow-sm">
    <div class="w-12 h-12 mx-auto mb-5 rounded-full bg-(--border) flex items-center justify-center text-strong">
      <Icon name="check" class="size-5" />
    </div>
    <h3 class="text-body-16 font-semibold text-strong mb-2">Pesan Terkirim</h3>
    <p class="text-body-14 text-muted max-w-sm mx-auto">
      Terima kasih telah menghubungi kami. Saya akan segera membalas pesan Anda dalam waktu 24 jam.
    </p>
  </div>
  
  <form id="contact-form" class="space-y-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <Input
          id="name"
          name="name"
          type="text"
          required
          label="Nama"
          class="contact-input" 
          placeholder="John Doe"
        />
        <Input
          id="email"
          name="email"
          type="email"
          label="Email"
          required
          class="contact-input" 
          placeholder="john@example.com"
        />
    </div>

    <Input
        id="subject"
        name="subject"
        type="text"
        label="Subjek"
        required
        class="contact-input" 
        placeholder="Tawaran kerja sama..."
    />

    <Textarea
      id="message"
      name="message"
      label="Pesan"
      required
      rows="4"
      class="contact-input" 
      placeholder="Tuliskan pesan Anda secara detail..."
      helper="Markdown is supported."
    ></Textarea>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
        <div class="flex items-center gap-2">
            <Icon name="info" class="size-4.5 fill text-(--info)" />
            <span class="text-label-14 text-(--info-fg)" set:text="Biasanya membalas dalam waktu 24 jam." />
        </div>
        <Button
            id="submit-btn"
            type="submit"
            size="md"
            variant="primary">
            <Spinner id='btn-spinner' size='sm' class='hidden' />
            <span id="btn-text">Kirim Pesan</span>
        </Button>
    </div>

    <Card id="error-message" padding='sm' radius='sm' class="hidden mt-4 bg-error/10 ring-(--error-soft)! text-error text-label-13 text-center">
        <div class="flex items-center gap-2">
            <Icon name="warning" class="size-4.5" />
            <span set:text="Terjadi kesalahan jaringan. Silakan periksa koneksi Anda dan coba lagi." />
        </div>
    </Card>
  </form>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMessage = document.getElementById('success-message');
  const errorMessage = document.getElementById('error-message');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');
  const formInputs = document.querySelectorAll('.contact-input');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (errorMessage) errorMessage.classList.add('hidden');

      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = 'Mengirim...';
      if (btnSpinner) btnSpinner.classList.remove('hidden');
      formInputs.forEach((input) => (input as HTMLInputElement).disabled = true);

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('https://formspree.io/f/xgvybkyq', {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(data),
        });

        if (res.ok) {
          form.classList.add('hidden');
          if (successMessage) successMessage.classList.remove('hidden');
        } else {
          throw new Error('Failed to send');
        }
      } catch (error) {
        if (errorMessage) errorMessage.classList.remove('hidden');
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Kirim Pesan';
        if (btnSpinner) btnSpinner.classList.add('hidden');
        formInputs.forEach((input) => (input as HTMLInputElement).disabled = false);
      }
    });
  }
</script>