---
// src/components/ui/SidebarLink.astro
interface Props {
  href: string;
  isActive?: boolean;
  grouped?: boolean;
}

const { 
  href, 
  isActive = false,
  grouped = true,
} = Astro.props;

const $ = {
  group: "relative ml-3 pb-1 last:pb-0!",
  groupItems: [
    "relative pr-2 py-1.5 -ml-3 rounded",
  ].join(" "),
  items: "relative flex items-center w-full text-body-13 font-medium",
  itemsIndicator: "absolute left-0 top-0 bottom-0 w-px bg-(--border) rounded-full"
}
---

{grouped ? (
  <ul class:list={[
    $.group,
  ]}>
    <span class={$.itemsIndicator} />
    <li class:list={[
      $.groupItems,
      isActive 
        ? "bg-(--accent)/10" 
        : "hover:bg-(--bg-muted)/80",
    ]}>
      <a
        href={href}
        class:list={[
          $.items,
          "pl-6",
          isActive
            ? "text-(--accent) border-(--accent)"
            : "text-(--fg)/80 border-transparent"
        ]}>
        {isActive && (
          <span class:list={[
            $.itemsIndicator,
            "left-3",
            isActive ? "bg-(--accent)!" : ""
          ]} />
        )}
        <slot />
      </a>
    </li>
  </ul>
) : (
  <a
    href={href}
    class:list={[
      $.items,
      "px-2 py-1.5 rounded transition-colors duration-150",
      isActive 
        ? "bg-(--accent)/10 text-(--accent) font-semibold" 
        : "text-(--fg) hover:bg-(--bg-muted)/80 active:bg-(--bg-muted)",
    ]}>
    <slot />
  </a>
)}
