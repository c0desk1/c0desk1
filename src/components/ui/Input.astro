---
// src/components/ui/Input.astro
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icons.astro';

interface Props extends HTMLAttributes<'input'> {
  label?: string;
  error?: string;
  helper?: string;
}

const {
  label,
  error,
  helper,
  id,
  type = 'text',
  class: className,
  required,
  ...rest
} = Astro.props;

const inputId = id || label?.toLowerCase().replace(/\s+/g, '-');
const errorId = `${inputId}-error`;
const helperId = `${inputId}-helper`;
const isPassword = type === 'password';

const hasPrefix = Astro.slots.has('prefix');
const hasSuffix = Astro.slots.has('suffix');

const $ = {
  wrapper: "flex flex-col gap-1.5 w-full",
  label: "text-label-14 text-(--fg-strong)",
  bar: "relative flex items-center w-full",
  prefix: "absolute left-2 pointer-events-none text-(--fg-muted) flex items-center justify-center z-10",
  suffix: "absolute right-2 pointer-events-none text-(--fg-muted) flex items-center justify-center z-10",
  input: [
    "w-full h-9 rounded-md",
    "border border-(--border) bg-transparent",
    "text-body-14 text-(--fg-strong)",
    "placeholder:text-(--fg-muted)",
    "focus:bg-(--bg-muted) focus:outline-none focus:ring-2 focus:ring-(--accent-ring) focus:border-(--border-strong)",
    "transition-opacity disabled:opacity-40 disabled:cursor-not-allowed",
  ].join(" "),
  toggle: [
    "absolute right-1.5 p-1.5 z-10 rounded-sm",
    "text-(--fg-muted) hover:text-(--fg-strong) active:text-(--fg-strong)",
    "focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-(--border)",
    "transition-opacity cursor-pointer"
  ].join(" "),
}
---

<div data-input-root class={$.wrapper}>
  {label && (
    <label for={inputId} class={$.label}>
      {label}
      {required && <span class="text-red-500 ml-0.5">*</span>}
    </label>
  )}
  <div class={$.bar}>
    {hasPrefix && (
      <div class={$.prefix}>
        <slot name="prefix" />
      </div>
    )}
    <input
      id={inputId}
      type={type}
      required={required}
      aria-invalid={!!error}
      aria-describedby={`${error ? errorId : ''} ${helper ? helperId : ''}`.trim() || undefined}
      class:list={[
        $.input,
        hasPrefix ? "pl-8" : "pl-3",
        hasSuffix ? "pr-8" : "pr-3",
        isPassword ? "pr-8" : "pr-3",
        error ? "border-(--error) text-(--error) focus:border-(--error) focus:ring-(--error)" : "",
        className,
      ]}
      {...rest as HTMLAttributes<'input'>}
    />

    {hasSuffix && (
      <div class={$.suffix}>
        <slot name="suffix" />
      </div>
    )}

    {isPassword && (
      <button
        type="button"
        data-password-toggle
        aria-label="Toggle password visibility"
        class={$.toggle}
      >
        <Icon data-eye-open name="eye-open" class="size-4" />
        <Icon data-eye-close name="eye-close" class="size-4 hidden" />
      </button>
    )}
  </div>

  {(error || helper || Astro.slots.has('helper')) && (
    <div class="flex flex-col gap-1 mt-1">
      {error && <p id={errorId} class="text-[12px] font-medium text-(--error) animate-in fade-in">{error}</p>}
      {(helper || Astro.slots.has('helper')) && (
        <div id={helperId} class="text-[12px] text-(--fg-muted)">
          {helper || <slot name="helper" />}
        </div>
      )}
    </div>
  )}
</div>

<style is:global>
  input:-webkit-autofill,
  input:-webkit-autofill:hover, 
  input:-webkit-autofill:focus, 
  input:-webkit-autofill:active {
    -webkit-box-shadow: 0 0 0 30px var(--bg-muted) inset !important;
    -webkit-text-fill-color: var(--fg-strong) !important;
    caret-color: var(--fg-strong) !important;
  }
</style>

<script>
  const initInputFeatures = () => {
    const inputRoots = document.querySelectorAll('[data-input-root]');

    inputRoots.forEach((root) => {
      const toggleBtn = root.querySelector('[data-password-toggle]') as HTMLButtonElement | null;
      const input = root.querySelector('input') as HTMLInputElement | null;
      
      if (!toggleBtn || !input) return;

      const eyeOpenIcon = toggleBtn.querySelector('[data-eye-open]');
      const eyeCloseIcon = toggleBtn.querySelector('[data-eye-close]');

      if (toggleBtn.dataset.bound === '1') return;
      toggleBtn.dataset.bound = '1';

      toggleBtn.addEventListener('click', () => {
        const isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';

        if (eyeOpenIcon && eyeCloseIcon) {
          eyeOpenIcon.classList.toggle('hidden', isPassword);
          eyeCloseIcon.classList.toggle('hidden', !isPassword);
        }
      });
    });
  };

  initInputFeatures();
  if (document.readyState !== 'loading') initInputFeatures();
</script>