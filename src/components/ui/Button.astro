---
// src/components/ui/Button.astro
import type { HTMLAttributes } from 'astro/types';
import Spinner from './Spinner.astro';
import Icons from './Icons.astro';

type ButtonVariant =
  | 'accent'
  | 'primary'
  | 'secondary'
  | 'outline'
  | 'ghost'
  | 'danger'
  | 'icon';

type ButtonSize = 
  | 'sm'
  | 'md'
  | 'lg';

export interface Props extends Omit<HTMLAttributes<'button'>, 'prefix'> {
  href?: string;
  target?: HTMLAttributes<'a'>['target'];
  rel?: HTMLAttributes<'a'>['rel'];
  variant?: ButtonVariant;
  size?: ButtonSize;
  prefix?: any;
  suffix?: any;
  prefixIcon?: string;
  suffixIcon?: string;
  loading?: boolean;
  loadingText?: string;
  block?: boolean;
  class?: string;
}

const {
  href,
  target,
  rel,
  variant = 'primary',
  size = 'md',
  prefix,
  prefixIcon,
  suffix,
  suffixIcon,
  loading = false,
  loadingText,
  block = false,
  disabled = false,
  class: className = '',
  ...props
} = Astro.props;

const isLink = !!href;
const isDisabled = loading || disabled;
const isIconOnly = variant === 'icon';

const baseClasses = [
  'inline-flex items-center justify-center shrink-0 ring-1 border outline-offset-4',
  'font-medium whitespace-nowrap',
  'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--accent-ring)',
  'disabled:opacity-50 disabled:pointer-events-none'
].join(" ");

const variantClasses: Record<ButtonVariant, string> = {
  accent: [
    'bg-(--accent) text-(--accent-fg) ring-transparent border-transparent',
    'hover:bg-(--accent)/80'
  ].join(" "),

  primary: [
    'bg-(--fg-strong) text-(--fg-inverted)! ring-transparent border-transparent',
    'hover:bg-(--fg-strong)/80'
  ].join(" "),

  secondary: [
    'bg-(--bg-subtle) text-(--fg) ring-(--border) border-transparent',
    'hover:bg-(--bg-muted)/80'
  ].join(" "),

  outline: [
    'bg-transparent ring-(--border-subtle) text-(--fg) border-transparent',
    'hover:bg-(--bg-muted)'
  ].join(" "),

  ghost: [
    'bg-transparent text-(--fg) ring-transparent border-transparent',
    'hover:bg-(--bg-muted)'
  ].join(" "),

  danger: [
    'bg-(--color-error) text-white ring-transparent border-transparent',
    'hover:bg-(--color-error)/80'
  ].join(" "),

  icon: [
    'bg-transparent text-(--fg-muted) ring-transparent border-transparent',
    'hover:bg-(--bg-muted) hover:text-(--fg-strong)'
  ].join(" ")
};

const sizeClasses: Record<ButtonSize, string> = {
  sm: 'h-7 px-2 text-button-13 gap-1.5',
  md: 'h-8 px-3 text-button-14 gap-2',
  lg: 'h-10 px-4 text-button-16 gap-2.5'
};

const iconSizeClasses: Record<ButtonSize, string> = {
  sm: 'size-6',
  md: 'size-8',
  lg: 'size-10'
};

const sizeClass = isIconOnly ? iconSizeClasses[size] : sizeClasses[size];
const hasDecorators = !!prefix || !!suffix || loading;

const alignmentClass = block 
  ? (hasDecorators ? 'w-full justify-start' : 'w-full justify-center') 
  : '';

const classes = [
  baseClasses,
  variantClasses[variant],
  sizeClass,
  alignmentClass,
  loading && 'opacity-80 pointer-events-none',
  isIconOnly && 'aspect-square p-0',
  className,
].filter(Boolean).join(' ');

const textContainerClasses = [
  "inline-flex items-center shrink-0 gap-1.5",
  block && hasDecorators ? "flex-1 justify-start text-start" : "justify-center text-center"
].join(" ");
---

{
  isLink ? (
    <a
      href={href}
      target={target}
      rel={rel}
      class:list={['rounded-full no-underline!', classes]}
      aria-busy={loading || undefined}
      aria-disabled={isDisabled ? 'true' : undefined}
      {...(props as any)}
    >
      {loading && <Spinner size="sm" class="inline-block items-center shrink-0" />}
      
      {!loading && (prefixIcon ? <Icons name={prefixIcon} class="size-4" /> : prefix)}

      {!isIconOnly && (
        <span class={textContainerClasses}>
          {loading && loadingText ? loadingText : <slot />}
        </span>
      )}
      {isIconOnly && !loading && <slot />}

      {suffixIcon && !loading && <Icons name={suffixIcon} class="size-4" />}
      {suffix && !loading && <span>{suffix}</span>}
    </a>
  ) : (
    <button
      type={(props as any).type || 'button'}
      disabled={isDisabled}
      class:list={['rounded', classes]}
      aria-busy={loading || undefined}
      aria-disabled={isDisabled ? 'true' : undefined}
      {...(props as any)}
    >
      {loading && <Spinner size="sm" class="inline-block items-center shrink-0" />}
      
      {!loading && (prefixIcon ? <Icons name={prefixIcon} class="size-4" /> : prefix)}

      {!isIconOnly && (
        <span class={textContainerClasses}>
          {loading && loadingText ? loadingText : <slot />}
        </span>
      )}

      {isIconOnly && !loading && <slot />}

      {suffixIcon && !loading && <Icons name={suffixIcon} class="size-4" />}
      {suffix && !loading && <span>{suffix}</span>}
    </button>
  )
}
