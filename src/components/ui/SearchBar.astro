---
// src/components/SearchBar.astro
import Icon from "./Icons.astro";
import Button from "./Button.astro";

interface Props {
  iconOnly?: boolean;
  class?: string;
}

const { 
  iconOnly = false,
  class: className= ""
} = Astro.props;
---
{iconOnly && (
  <Button 
    data-drawer-trigger="search-drawer"
    aria-label="Buka pencarian"
    variant="icon"
    size="md">
    <Icon name="search" fill class="size-4.5"
    />
  </Button>
)}
{!iconOnly && (
  <Button
    data-drawer-trigger="search-drawer"
    aria-label="Buka pencarian"
    variant="secondary"
    size="md"
    block
    class:list={[
      "group flex items-center text-(--fg-muted) justify-between w-auto rounded-md!",
      className
    ]}
    prefix={<Icon name="search" fill class="size-4" />}
    suffix={
      <div class="hidden items-center gap-1 font-mono text-[10px] font-medium text-(--fg-muted) transition-colors group-hover:text-(--fg) lg:flex select-none pointer-events-none">
        <kbd class="flex h-5 items-center justify-center rounded border border-(--border-subtle) bg-(--bg-muted) px-1.5 min-w-5 shadow-[0_1px_0_0_rgba(0,0,0,0.05)]">
          Ctrl
        </kbd>
        <span>✚</span>
        <kbd class="flex h-5 items-center justify-center rounded border border-(--border-subtle) bg-(--bg-muted) px-1.5 min-w-5 shadow-[0_1px_0_0_rgba(0,0,0,0.05)]">
          K
        </kbd>
      </div>
    }>
    Cari...
  </Button>
)}
