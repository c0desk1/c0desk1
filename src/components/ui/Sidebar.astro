---
interface Props {
  id?: string;
  class?: string;
}

const { 
  id, 
  class: className = '' 
} = Astro.props;

const $ = {
  baseClass: "flex flex-col h-full w-full py-4 px-0 flex-1 overflow-y-auto scrollbar-hide"
}
---

<nav id={id} aria-label="Sidebar Navigation" class:list={[
  $.baseClass,
  className
]}>
  <slot />
</nav>
