---
// src/components/ui/Textarea.astro
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'textarea'> {
  label?: string;
  error?: string;
  helper?: string;
}

const {
  label,
  error,
  helper,
  id,
  class: className,
  rows = 4,
  required,
  ...rest
} = Astro.props;

const textareaId = id || label?.toLowerCase().replace(/\s+/g, '-');

const $ = {
  wrapper: "flex flex-col gap-2 w-full",
  label: "text-label-14 text-(--fg-strong)",
  textarea: [
    "w-full rounded-md px-3 py-2",
    "border border-(--border-subtle) bg-transparent",
    "text-body-14 text-(--fg-strong)",
    "placeholder:text-(--fg-muted)",
    "focus:bg-(--bg-muted)/40 focus:outline-none focus:ring-2 focus:ring-(--accent-ring) focus:border-(--border-strong)",
    "transition-opacity disabled:opacity-40 disabled:cursor-not-allowed",
    "resize-y min-h-[56px]",
  ].join(" "),
}
---

<div data-textarea-root class={$.wrapper}>
  {label && (
    <label for={textareaId} class={$.label}>
        {label}
        {required && <span class="text-red-500 ml-0.5">*</span>}
    </label>
  )}
  
  <div class="relative flex items-center w-full">
    <textarea
      id={textareaId}
      rows={rows}
      class:list={[
        $.textarea,
        error ? "border-(--error) text-(--error) focus:border-(--error) focus:ring-(--error)" : "",
        className,
      ]}
      {...rest as HTMLAttributes<'textarea'>}
    ></textarea>
  </div>

  {(error || helper || Astro.slots.has('helper')) && (
    <div class="flex flex-col gap-1 mt-2">
      {error && <p class="text-[12px] font-medium text-(--error) animate-in fade-in">{error}</p>}
      {(helper || Astro.slots.has('helper')) && (
        <div class="text-[12px] text-(--fg-muted)">
          {helper || <slot name="helper" />}
        </div>
      )}
    </div>
  )}
</div>

<style is:global>
  textarea:-webkit-autofill,
  textarea:-webkit-autofill:hover,
  textarea:-webkit-autofill:focus,
  textarea:-webkit-autofill:active {
    -webkit-box-shadow: 0 0 0 30px var(--bg-muted) inset !important;
    -webkit-text-fill-color: var(--fg-strong) !important;
    caret-color: var(--fg-strong) !important;
  }
</style>