---
// src/components/AiDrawerContent.astro
import Button from "./ui/Button.astro";
import Icons from "./ui/Icons.astro";
import Textarea from "./ui/Textarea.astro";
---

<div class="flex flex-col h-full max-w-2xl mx-auto w-full pb-(--safe-bottom)">
  <div class="flex items-center gap-2 mb-4 px-2 shrink-0">
    <div class="relative flex size-6 items-center justify-center">
      <span class="absolute inset-0 rounded bg-(--accent) ring-1 ring-(--accent)/80 opacity-20 blur-md"></span>
      <Icons name="ask-ai" class="relative size-5 text-(--accent)" />
    </div>
    <h2 class="text-heading-16 font-semibold text-(--fg-strong) text-balance">AI Assistant</h2>
  </div>

  <div id="ai-chat-container" class="ai-scroll flex-1 overflow-y-auto space-y-4 mb-6 px-3 py-4 text-sm">
    <div class="flex gap-3 items-start">
      <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-(--bg-subtle) border border-(--border-subtle) text-(--fg-strong)">
        <Icons name="ai-agent" class="size-4" />
      </div>
      <div class="px-3 py-2 rounded-md rounded-tl-none bg-(--bg-subtle)/80 ring-1 ring-(--border-subtle)/80 text-(--fg-muted) max-w-[85%] leading-relaxed">
        Halo! Tanyakan apa saja tentang dokumentasi, artikel, atau kode teknikal di situs ini. AI akan membantu meresponsnya secara instan.
      </div>
    </div>
  </div>

  <div class="ai-input-bar flex items-end gap-2 px-2 shrink-0 pt-2 mt-2">
    <Textarea
      id="ai-drawer-input"
      rows={2}
      placeholder="Ketik pertanyaan teknis..."
    ></Textarea>
    <Button
      id="ai-drawer-submit"
      variant="icon"
      size="md"
      class="ai-send-btn relative bg-(--fg-strong)! text-(--fg-inverted)!"
      disabled
      aria-label="Kirim pertanyaan"
    >
      <Icons name="ask-ai" class="ai-send-icon size-4" />
      <Icons name="spinner" class="ai-send-spinner size-4 hidden" />
    </Button>
  </div>
</div>

<template id="template-msg-user">
  <div class="flex gap-3 justify-end items-start ai-msg-in">
    <div class="px-2 py-1.5 rounded-md rounded-tr-none bg-(--fg-strong) border border-transparent text-(--fg-inverted) max-w-[85%] whitespace-pre-wrap leading-relaxed shadow-sm">
    </div>
  </div>
</template>

<template id="template-msg-ai">
  <div class="flex gap-3 justify-start items-start mb-4 ai-msg-in group">
    <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-(--bg-subtle) border border-(--border-subtle)/80 text-(--fg-strong) shadow-xs">
      <Icons name="ai-agent" class="size-4" />
    </div>
    <div class="relative max-w-[85%]">
      <div data-ai-text class="px-3 py-2 rounded-md rounded-tl-none bg-(--bg-subtle) border border-(--border-subtle)/80 text-(--fg-strong) whitespace-pre-wrap leading-relaxed shadow-xs">
      </div>
      <Button
        data-ai-copy
        type="button"
        aria-label="Salin jawaban"
        variant="icon"
        size="md"
        class="ai-copy-btn absolute -bottom-3 right-1 opacity-0 group-hover:opacity-100 focus-visible:opacity-100"
      >
        <Icons name="copy" class="size-3.5" />
      </Button>
    </div>
  </div>
</template>

<template id="template-msg-typing">
  <div class="flex gap-3 justify-start items-start ai-msg-in mb-4">
    <div class="flex size-7 shrink-0 items-center justify-center rounded-full bg-(--bg-subtle) border border-(--border-subtle)/80 text-(--fg-strong) shadow-xs">
      <Icons name="ai-agent" class="size-4" />
    </div>
    <div class="ai-typing px-3 py-2 rounded-2xl rounded-tl-sm bg-(--bg-subtle) border border-(--border-subtle) shadow-xs">
      <span></span><span></span><span></span>
    </div>
  </div>
</template>

<style is:global>
  .ai-scroll {
    scroll-behavior: smooth;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, black 10px, black calc(100% - 10px), transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, black 10px, black calc(100% - 10px), transparent 100%);
  }

  @keyframes ai-msg-in {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  .ai-msg-in {
    animation: ai-msg-in 0.28s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .ai-typing {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .ai-typing span {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--fg-muted);
    opacity: 0.5;
    animation: ai-typing-bounce 1.1s ease-in-out infinite;
  }
  .ai-typing span:nth-child(2) { animation-delay: 0.15s; }
  .ai-typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes ai-typing-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-4px); opacity: 1; }
  }

  .ai-send-btn {
    position: relative;
    opacity: 1;
    cursor: pointer
  }
  .ai-send-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .ai-send-icon {
    transition: opacity 0.15s ease;
  }
  .ai-send-spinner {
    display: none;
    position: absolute;
    inset: 0;
    margin: auto;
  }
  .ai-send-btn.is-loading .ai-send-icon { opacity: 0; }
  .ai-send-btn.is-loading .ai-send-spinner {
    display: block;
    animation: ai-spin 0.7s linear infinite;
  }
  @keyframes ai-spin {
    to { transform: rotate(360deg); }
  }

  .ai-copy-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    color: var(--fg-muted);
    transition: opacity 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }
  .ai-copy-btn:hover {
    color: var(--fg-strong);
    transform: scale(1.08);
  }
  .ai-copy-btn.copied {
    color: var(--accent);
  }

  [data-ai-text].is-error {
    color: var(--fg-muted);
  }
</style>

<script>
  const submitBtn = document.getElementById('ai-drawer-submit') as HTMLButtonElement;
  const inputEl = document.getElementById('ai-drawer-input') as HTMLTextAreaElement;
  const chatContainer = document.getElementById('ai-chat-container');

  const tmplUser = document.getElementById('template-msg-user') as HTMLTemplateElement;
  const tmplAi = document.getElementById('template-msg-ai') as HTMLTemplateElement;
  const tmplTyping = document.getElementById('template-msg-typing') as HTMLTemplateElement;

  function scrollToBottom() {
    chatContainer?.scrollTo({ top: chatContainer.scrollHeight, behavior: 'smooth' });
  }

  function appendUserMessage(text: string) {
    const clone = tmplUser.content.cloneNode(true) as DocumentFragment;
    const bubble = clone.querySelector('div > div') as HTMLElement;
    if (bubble) bubble.textContent = text;
    chatContainer?.appendChild(clone);
    scrollToBottom();
  }

  function appendTypingIndicator() {
    const clone = tmplTyping.content.cloneNode(true) as DocumentFragment;
    const node = clone.firstElementChild as HTMLElement;
    chatContainer?.appendChild(clone);
    scrollToBottom();
    return node;
  }

  function appendAiMessage(text: string, isError = false) {
    const clone = tmplAi.content.cloneNode(true) as DocumentFragment;
    const bubble = clone.querySelector('[data-ai-text]') as HTMLElement;
    const copyBtn = clone.querySelector('[data-ai-copy]') as HTMLButtonElement;

    if (bubble) {
      bubble.textContent = text;
      bubble.classList.toggle('is-error', isError);
    }

    if (copyBtn) {
      if (isError) {
        copyBtn.remove();
      } else {
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(text);
            copyBtn.classList.add('copied');
            setTimeout(() => copyBtn.classList.remove('copied'), 1200);
          } catch {
          }
        });
      }
    }

    chatContainer?.appendChild(clone);
    scrollToBottom();
  }

  function autosize() {
    inputEl.style.height = 'auto';
    inputEl.style.height = `${inputEl.scrollHeight}px`;
  }

  function updateSendState() {
    submitBtn.disabled = inputEl.value.trim().length === 0;
  }

  function setLoading(loading: boolean) {
    submitBtn.classList.toggle('is-loading', loading);
    submitBtn.disabled = loading || inputEl.value.trim().length === 0;
    inputEl.disabled = loading;
  }

  async function handleDrawerAsk() {
    const question = inputEl.value.trim();
    if (!question) return;

    inputEl.value = '';
    autosize();
    updateSendState();
    setLoading(true);

    appendUserMessage(question);
    const typingNode = appendTypingIndicator();

    const context = document.querySelector('article')?.innerText || '';

    try {
      const res = await fetch('/api/ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question, context }),
      });
      const data = await res.json();
      typingNode?.remove();
      appendAiMessage(data.answer || 'Tidak ada respons.');
    } catch {
      typingNode?.remove();
      appendAiMessage('Gagal menghubungi AI. Coba lagi sebentar lagi.', true);
    } finally {
      setLoading(false);
      inputEl?.focus();
    }
  }

  submitBtn?.addEventListener('click', handleDrawerAsk);
  inputEl?.addEventListener('input', () => {
    autosize();
    updateSendState();
  });
  inputEl?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleDrawerAsk();
    }
  });
</script>
