---
import { ROUTES, SITE } from "@/consts";
import Section from "@ui/Section.astro";
import Icon from "@ui/Icons.astro";
import Button from "@ui/Button.astro";

interface Props {
    title: string;
    description: string;
}

const {
    title,
    description
} = Astro.props;

const baseUrl = SITE.url.replace(/\/$/, "");
const rssUrl = `${baseUrl}${ROUTES.rss}`;

const $ = {
    wrapper: "relative overflow-hidden items-center w-full",
    stack: "flex flex-col gap-2 max-w-xl",
    title: "text-heading-32 md:text-heading-40 font-semibold text-(--fg-strong) mb-2 text-balance",
    description: "text-body-16 text-(--fg-muted) text-pretty"
}
---

<header class={$.wrapper}>
    <Section size="md">
        <div class="absolute top-0 inset-x-0 h-px w-full bg-linear-to-r from-transparent via-(--accent)/80 to-transparent opacity-50"></div>
        <div class="absolute inset-0 bg-[linear-gradient(rgba(128,128,128,0.1)_1px,transparent_1px),linear-gradient(90deg,rgba(128,128,128,0.1)_1px,transparent_1px)] bg-size-[40px_40px] mask-[radial-gradient(ellipse_80%_80%_at_50%_0%,#000_40%,transparent_100%)] pointer-events-none z-0"></div>
        <div class="absolute inset-0 z-0 pointer-events-none mix-blend-overlay opacity-[0.35] dark:opacity-[0.15]">
            <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                <filter id="noiseFilter">
                <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" stitchTiles="stitch" />
                </filter>
                <rect width="100%" height="100%" filter="url(#noiseFilter)"></rect>
            </svg>
        </div>
        <div class="relative z-10 flex items-start justify-between w-full gap-4 px-2">
            <div class={$.stack}>
                <h1 class={$.title} set:html={title} />
                <p class={$.description} set:html={description} />
            </div>
            <Button
                aria-label="RSS Feed"
                title="RSS Feed"
                variant="secondary"
                size="md"
                href={rssUrl}
                prefix={<Icon name="rss" class="size-4.5" />}>
                Subscribe
            </Button>
        </div>
    </Section>
</header>
