---
// src/components/blog/RelatedPosts.astro
import type { CollectionEntry } from "astro:content";
import { formatDate } from "@lib/utils";
import { ROUTES } from "@/consts";

export interface Props {
  currentEntry: CollectionEntry<"blog">;
  allPosts: CollectionEntry<"blog">[];
  maxItems?: number;
}

const { 
    currentEntry, 
    allPosts, 
    maxItems = 3 
} = Astro.props;

const candidatePosts = allPosts.filter(
  (post) =>
    post.id !== currentEntry.id &&
    !post.data.draft &&
    (post.data.tags?.length || post.data.category)
);

if (candidatePosts.length === 0) {
  return;
}

let currentTags = currentEntry.data.tags || [];
if (currentTags.length === 0 && currentEntry.data.category) {
  currentTags = [currentEntry.data.category];
}

if (currentTags.length === 0) {
  return;
}

const postsWithScore = candidatePosts.map((post) => {
  let postTags = post.data.tags || [];
  if (postTags.length === 0 && post.data.category) {
    postTags = [post.data.category];
  }
  const commonTags = postTags.filter((tag) => currentTags.includes(tag));
  const score = commonTags.length;
  return { post, score };
});

postsWithScore.sort((a, b) => {
  if (b.score !== a.score) return b.score - a.score;
  const dateA = a.post.data.pubDate?.getTime() ?? 0;
  const dateB = b.post.data.pubDate?.getTime() ?? 0;
  return dateB - dateA;
});

const related = postsWithScore.slice(0, maxItems).map((item) => item.post);

const $ = {
    label: "text-heading-24 font-semibold text-(--fg-strong) mb-6",
    card: "flex flex-col rounded ring-1 ring-(--border) bg-transparent p-2 gap-0.5 hover:bg-(--bg-muted) active:bg-(--bg-muted)",
    title: "text-heading-16 font-medium text-(--fg) group-hover:text-(--fg-strong) group-active:text-(--fg-strong)",
    date: "text-body-14! text-(--fg-muted) mt-auto"
}
---

{
  related.length > 0 && (
    <section>
      <h2 class={$.label} set:text="Terkait." />
      <ul class="grid grid-cols-1 gap-4">
        {related.map((post) => {
          const slug = post.data.slug || post.id.replace(/\.(md|mdx)$/, '');
          const postHref = `${ROUTES.blog}/${slug}/`;

          return (
            <li class="group">
              <a
                href={postHref}
                class={$.card}
              >
                <h3 class={$.title} set:html={post.data.title} />
                <p>
                  {post.data.pubDate && (
                    <time class={$.date} set:html={formatDate(post.data.pubDate)} />
                  )}
                </p> 
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )
}
