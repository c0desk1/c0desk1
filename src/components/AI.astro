---
import Button from "./ui/Button.astro";
import Icons from "./ui/Icons.astro";

interface Props {
  iconOnly?: boolean;
}

const { 
  iconOnly = false,
} = Astro.props;

const $ = {
    icon: "size-5"
}
---
{iconOnly && (
    <Button data-drawer-trigger="ai-assistant-drawer"
        variant="icon"
        size="md">
        <Icons name="ask-ai" class={$.icon} />
    </Button>
)}
{!iconOnly && (
    <Button data-drawer-trigger="ai-assistant-drawer"
        variant="outline"
        size="md"
        prefix={<Icons name="ask-ai" class={$.icon} />}>
        Tanya AI
    </Button>
)}
