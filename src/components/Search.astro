---
// src/components/Search.astro
import Input from "./ui/Input.astro";
import Button from "./ui/Button.astro";
import Icon from "./ui/Icons.astro";
import Spinner from "./ui/Spinner.astro";

const PAGE_SIZE = 6;

const ui = {
  bar: "flex items-center gap-2 py-2 px-3 border-b border-(--border)",
  iconSlot: "relative block shrink-0 items-center justify-center size-5 transition-opacity duration-(--duration)",
  spinner: "absolute inset-0 hidden size-5! text-(--fg)/80",
  results: "flex-1 overflow-y-auto overscroll-contain p-2",
  list: "space-y-4",
  empty: "p-10 text-center text-sm text-(--fg-muted)",
  footer: "hidden px-2 pb-2 pt-4",
  total: "text-xs text-(--fg-muted) px-2 py-1.5",
  closeDesk: "font-mono rounded! hidden! sm:inline-flex!",
  closeMob: "inline-flex! sm:hidden! shrink-0 p-1.5",
};
---

<dialog id="search-drawer" class="search-dialog">
  <search class="search-content">
    <div class={ui.bar}>
      <Input id="search-input" type="text" placeholder="Ketik untuk mencari..." autocomplete="off" spellcheck="false">
        <Fragment slot="prefix">
          <div class={ui.iconSlot}>
            <Icon id="search-icon" name="search" fill class="h-full w-full" />
            <Spinner id="search-spinner" size="sm" class={ui.spinner} />
          </div>
        </Fragment>
      </Input>
      <Button data-action="close-search" variant="icon" size="md" class={ui.closeMob}>
        <Icon name="close" class="size-5" />
      </Button>
      <Button data-action="close-search" variant="secondary" size="sm" class={ui.closeDesk}>ESC</Button>
    </div>

    <div id="search-results" class={ui.results}>
      <div id="search-total" class={`${ui.total} hidden`}></div>
      <div id="search-empty" class="hidden"></div>
      <ul id="search-list" class={ui.list} role="listbox"></ul>
      <div id="search-footer" class={ui.footer}>
        <Button id="search-load-more" variant="secondary" size="md" block>Tampilkan lebih banyak</Button>
      </div>
    </div>
  </search>
</dialog>

<style is:global>
  .search-dialog {
    padding: 0; margin: 0; border: none; background: transparent;
    width: 100vw; height: 100vh; max-width: none; max-height: none;
  }
  .search-dialog::backdrop {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
  }
  .search-content {
    width: 100%; height: 100%;
    background: var(--bg-subtle);
    display: flex; flex-direction: column;
  }

  @media (min-width: 45rem) {
    .search-dialog { display: flex; align-items: center; justify-content: center; }
    .search-content {
      width: 600px; height: 80vh;
      border-radius: 12px;
      border: 1px solid var(--border);
      box-shadow: var(--shadow-lg);
    }
  }
</style>

<script is:inline define:vars={{ PAGE_SIZE }}>
  (() => {
    const dialog = document.getElementById("search-drawer");
    const input = document.getElementById("search-input");
    const list = document.getElementById("search-list");
    const iconEl = document.getElementById("search-icon");
    const spinnerEl = document.getElementById("search-spinner");

    function setLoading(on) {
      iconEl?.classList.toggle("opacity-0", on);
      spinnerEl?.classList.toggle("hidden", !on);
    }

    function open() {
      dialog.showModal();
      input?.focus();
    }

    function close() {
      dialog.close();
      input.value = "";
      list.innerHTML = "";
    }

    document.addEventListener("click", (e) => {
      if (e.target.closest('[data-drawer-trigger="search-drawer"]')) open();
      if (e.target.closest('[data-action="close-search"]')) close();
    });

    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === "k") {
        e.preventDefault();
        dialog.open ? close() : open();
      }
    });

    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) close();
    });
  })();
</script>