---
// src/components/Search.astro
---

<!-- DIALOG MURNI TANPA WRAPPER ANEH -->
<dialog id="search-drawer" class="search-dialog">
  <div class="debug-container">
    <p>Debug Dialog: Jika Anda melihat teks ini, dialog terbuka.</p>
    <button data-action="close-search" class="debug-close-btn">Tutup Dialog</button>
  </div>
</dialog>

<style is:global>
  /* 1. Reset Dialog */
  .search-dialog {
    padding: 0; margin: 0; border: none; background: transparent;
    width: 100vw; height: 100vh; max-width: none; max-height: none;
    /* KUNCI: Dialog harus display: none saat tidak open */
    display: none;
  }

  /* 2. Hanya tampil saat atribut [open] ada */
  .search-dialog[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* 3. Backdrop */
  .search-dialog::backdrop {
    background: rgba(0, 0, 0, 0.5);
  }

  /* 4. Container Debug */
  .debug-container {
    width: 300px; padding: 2rem;
    background: white; border-radius: 8px;
    text-align: center; color: black;
  }

  .debug-close-btn {
    margin-top: 1rem; padding: 0.5rem 1rem;
    background: red; color: white; border: none; border-radius: 4px;
    cursor: pointer;
  }
</style>

<script is:inline>
  (() => {
    const dialog = document.getElementById("search-drawer");

    // Event Global Buka (pakai tombol di page lain)
    document.addEventListener("click", (e) => {
      if (e.target.closest('[data-drawer-trigger="search-drawer"]')) {
        console.log("Membuka dialog...");
        dialog.showModal();
      }
      if (e.target.closest('[data-action="close-search"]')) {
        console.log("Menutup dialog...");
        dialog.close();
      }
      // Klik backdrop
      if (e.target === dialog) {
        dialog.close();
      }
    });
  })();
</script>