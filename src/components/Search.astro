---
// src/components/Search.astro (EMPTY TEST)
---

<dialog id="search-drawer" class="search-dialog">
  <div class="search-panel">
    <!-- Kosong tanpa isi -->
  </div>
</dialog>

<style is:global>
  .search-dialog {
    padding: 0;
    margin: auto;
    border: none;
    background: transparent;
    max-width: none;
    max-height: none;
    overflow: visible;
  }

  .search-dialog::backdrop {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
  }

  .search-panel {
    background: var(--bg-subtle, #ffffff);
    width: 100vw;
    height: 100vh;
  }

  @media (min-width: 45rem) {
    .search-panel {
      width: 400px;
      height: 200px;
      border-radius: 12px;
      border: 1px solid var(--border);
    }
  }
</style>

<script is:inline>
  (() => {
    const dialog = document.getElementById("search-drawer");

    function open() {
      if (!dialog.open) dialog.showModal();
    }

    function close() {
      if (dialog.open) {
        dialog.close();
        document.body.style.overflow = "";
        document.querySelectorAll('body > *').forEach(el => el.removeAttribute('inert'));
      }
    }

    document.addEventListener("click", (e) => {
      if (e.target.closest('[data-drawer-trigger="search-drawer"]')) open();
      if (e.target === dialog) close();
    });

    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === "k") {
        e.preventDefault();
        dialog.open ? close() : open();
      }
      if (e.key === "Escape" && dialog.open) close();
    });

    document.addEventListener("open-search", open);
  })();
</script>
