---
// src/components/Search.astro (DEBUG VERSION)
import Button from "@ui/Button.astro";
import Icon from "@ui/Icons.astro";
import Input from "@ui/Input.astro";
---

<dialog id="search-drawer" class="search-dialog">
  <search class="search-content">
    <div class="flex items-center gap-2 py-4 px-4 border-b border-(--border) bg-(--bg-subtle)">
      <Input
        id="search-input"
        type="text"
        placeholder="Ketik untuk tes debug..."
        autocomplete="off"
        spellcheck="false"
      />
      <Button 
        data-action="close-search" 
        aria-label="Tutup pencarian" 
        variant="secondary" 
        size="sm">
        Tutup / ESC
      </Button>
    </div>

    <div class="p-8 text-center text-sm text-(--fg-muted)">
      <p class="font-bold text-lg text-(--fg-strong) mb-2">Mode Debug Dialog Aktif</p>
      <p>Jika dialog ini tertutup rapi saat Anda mengklik backdrop, tombol tutup, atau menekan ESC, berarti struktur dasarnya sudah normal.</p>
    </div>
  </search>
</dialog>

<style is:global>
  /* Reset dasar dialog */
  .search-dialog {
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
  }

  /* Backdrop gelap transparan */
  .search-dialog::backdrop {
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
  }

  /* Tampilan Mobile: Full screen */
  .search-content {
    width: 100%;
    height: 100%;
    background: var(--bg-subtle, #ffffff);
    display: flex;
    flex-direction: column;
  }

  /* Tampilan Desktop: Modal Center (Hanya aktif saat dialog [open]) */
  @media (min-width: 45rem) {
    .search-dialog[open] {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .search-content {
      width: 600px;
      height: 400px;
      border-radius: 12px;
      border: 1px solid var(--border);
      box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);
      overflow: hidden;
    }
  }
</style>

<script is:inline>
  (() => {
    const dialog = document.getElementById("search-drawer");
    const input = document.getElementById("search-input");

    function open() {
      console.log("[DEBUG] Dialog dibuka");
      dialog.showModal();
      setTimeout(() => input?.focus(), 50);
    }

    function close() {
      console.log("[DEBUG] Dialog ditutup");
      dialog.close();
      if (input) input.value = "";
    }

    // Global Listener untuk buka/tutup
    document.addEventListener("click", (e) => {
      const trigger = e.target.closest('[data-drawer-trigger="search-drawer"]');
      const closeBtn = e.target.closest('[data-action="close-search"]');
      
      if (trigger) {
        e.preventDefault();
        open();
      }
      if (closeBtn) {
        e.preventDefault();
        close();
      }
      // Tutup jika klik area backdrop di luar kotak search-content
      if (e.target === dialog) {
        close();
      }
    });

    // Shortcut Ctrl+K atau Cmd+K
    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === "k") {
        e.preventDefault();
        if (dialog.open) {
          close();
        } else {
          open();
        }
      }
    });

    document.addEventListener("open-search", () => {
      open();
    });
  })();
</script>