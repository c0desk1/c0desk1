---
// src/components/Footer.astro
import { 
  SITE, 
  NAV 
} from "@/consts";

import Container from "@ui/Container.astro";
import Section from "@ui/Section.astro";
import Particles from "./ui/Particles.astro";
import Socials from "./Socials.astro";
import Theme from "./Theme.astro";
import Logo from "./ui/Logo.astro";

const currentYear = new Date().getFullYear();

const copyrightYear =
  currentYear > SITE.foundingYear
    ? `${SITE.foundingYear}–${currentYear}`
    : SITE.foundingYear;

const baseUrl = SITE.url.replace(/\/$/, "");

const $ = {
  wrapper: "relative mt-auto shrink-0 border-t border-(--border-subtle)",
  group: "grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4",
  navigation: "flex flex-col gap-3 items-start",
  label: "text-label-14 font-medium uppercase font-mono text-(--fg-strong)",
  title: "text-body-14 text-(--fg-muted) font-medium hover:text-(--fg-strong) active:text-(--fg-strong)",
  meta: "flex flex-col-reverse sm:flex justify-between mt-8 pt-4 gap-2 items-center text-center text-body-14 text-(--fg-muted)/60",
  metaAction: "flex items-center gap-1.5"
}
---

<footer class={$.wrapper}>
  <Particles />
  <Section size="md">
    <Container size="lg">
      <div class={$.group}>
        {NAV.footerBar.map((section) => (
          <div class={$.navigation}>
            <h3 class={$.label} set:html={section.title} />
            <ul class="space-y-1.5">
              {section.items.map((item) => {
                const isExternal = item.href.startsWith("http");
                const href = isExternal ? item.href : `${baseUrl}${item.href.endsWith('/') ? item.href : `${item.href}/`}`;
                
                return (
                  <li>
                    <a href={href}
                      class={$.title}
                      {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                      {item.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
        <div class="flex items-start">
          <Logo />
        </div>
      </div>
      <div class={$.meta}>
        Copyright {SITE.name} {copyrightYear}. All rights reserved.
        <div class={$.metaAction}>
          <Socials />
          <Theme />
        </div>
      </div>
    </Container>
  </Section>
</footer>
