---
// src/components/CopyDropdown.astro
import Icon from "@ui/Icons.astro";

interface Props {
  label?: string;
  class?: string;
  rawMarkdown?: string;
}

const { 
  label = "Copy Page", 
  class: className = "", 
  rawMarkdown = "" 
} = Astro.props;

const safeMarkdown = encodeURIComponent(rawMarkdown);

const s = {
  wrapper: [
    'relative inline-flex items-stretch rounded ring-1 shadow-(--shadow-sm)',
    'ring-(--border) bg-(--bg-subtle)',
    'transition-shadow duration-(--duration)'
  ].join(" "),

  actionGroup: [
    'flex items-center gap-1.5 text-button-13 md:text-button-14',
    'hover:bg-(--bg-muted)',
    'cursor-pointer select-none'
  ].join(" "),

  actionIcon: 'relative inline-flex items-center justify-center shrink-0 size-4',

  actionDropdown: [
    'absolute right-0 top-[calc(100%+0.5rem)] min-w-[11rem] z-50 rounded-md ring-1 p-1',
    'ring-(--border) bg-(--bg-subtle) shadow-(--shadow-lg)',
    'animate-in fade-in slide-in-from-top-2 origin-top-right',
  ].join(" "),

  actionDropdownItems: [
    'flex items-center gap-2 p-2 text-button-13 md:text-button-14 text-start rounded w-full',
    'text-(--fg) hover:bg-(--bg-muted) hover:text-(--fg-strong)',
    'cursor-pointer transition-colors'
  ].join(" "),
};

// Hanya menyisakan aksi murni untuk Copy & View Markdown
const ACTIONS = [
  { action: "url", icon: "link", message: "Copy as URL" },
  { action: "markdown", icon: "file", message: "Copy as Markdown" },
  { action: "view", icon: "eye", message: "View Source" },
];
---

<copy-dropdown data-markdown={safeMarkdown} class:list={[s.wrapper, className]}>
  <button 
    type="button"
    data-action="copy-default" 
    aria-label="Copy page URL" 
    class:list={["px-2.5 py-2 rounded-l", s.actionGroup]}
  >
    <div class={s.actionIcon}>
      <Icon name="copy" class="icon-copy w-full h-full text-(--fg-strong)" />
      <Icon name="check" class="icon-check w-full h-full hidden absolute inset-0 text-(--accent) transition-opacity duration-(--duration)" />
    </div>
    <span>{label}</span>
  </button>

  <details class="relative group">
    <summary class:list={[
      "px-2.5 py-2 rounded-r border-l border-(--border) h-full",
      "list-none flex items-center justify-center",
      s.actionGroup
    ]}>
      <div class={s.actionIcon}>
        <Icon name="chevron-down" class="w-full h-full text-(--fg-strong) group-open:rotate-180 transition-transform" />
      </div>
    </summary>

    <div class={s.actionDropdown}>
      {ACTIONS.map((item) => (
        <button
          type="button"
          data-action={item.action}
          class={s.actionDropdownItems}
        >
          <Icon name={item.icon as any} class={s.actionIcon} />
          {item.message}
        </button>
      ))}
    </div>
  </details>
</copy-dropdown>

<script>
  class CopyDropdown extends HTMLElement {
    private closeOnOutsideClick: (e: MouseEvent) => void;

    connectedCallback() {
      const rawMarkdown = decodeURIComponent(this.dataset.markdown || "");
      const primaryBtn = this.querySelector('[data-action="copy-default"]');
      const details = this.querySelector('details');
      
      primaryBtn?.addEventListener('click', () => {
        this.handleCopy(window.location.href);
      });

      this.querySelectorAll('button[data-action]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const action = (e.currentTarget as HTMLElement).getAttribute('data-action');
          details?.removeAttribute('open');

          if (action === 'url') {
            this.handleCopy(window.location.href);
          } 
          else if (action === 'markdown') {
            if (rawMarkdown) this.handleCopy(rawMarkdown);
          } 
          else if (action === 'view') {
            if (rawMarkdown) {
              const blob = new Blob([rawMarkdown], { type: 'text/plain;charset=utf-8' });
              const url = URL.createObjectURL(blob);
              window.open(url, '_blank');
            }
          }
        });
      });

      this.closeOnOutsideClick = (e: MouseEvent) => {
        if (details?.hasAttribute('open') && !this.contains(e.target as Node)) {
          details.removeAttribute('open');
        }
      };
      document.addEventListener('click', this.closeOnOutsideClick);
    }

    disconnectedCallback() {
      document.removeEventListener('click', this.closeOnOutsideClick);
    }

    private async handleCopy(text: string) {
      try {
        await navigator.clipboard.writeText(text);
        const iconCopy = this.querySelector('.icon-copy');
        const iconCheck = this.querySelector('.icon-check');
        
        iconCopy?.classList.add('hidden');
        iconCheck?.classList.remove('hidden');
        
        setTimeout(() => {
          iconCopy?.classList.remove('hidden');
          iconCheck?.classList.add('hidden');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy: ', err);
      }
    }
  }

  customElements.define('copy-dropdown', CopyDropdown);
</script>