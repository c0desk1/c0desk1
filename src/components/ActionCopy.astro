---
// src/components/CopyDropdown.astro
import Icon from "@ui/Icons.astro";

interface Props {
  label?: string;
  class?: string;
  rawMarkdown?: string;
}

const { 
  label = "Copy Page", 
  class: className, 
  rawMarkdown = "" 
} = Astro.props;

const uniqueId = `copy-dropdown-${Math.random().toString(36).substring(2, 9)}`;

const s = {
  wrapper: [
    'copy-dropdown-wrapper',
    'relative inline-flex items-stretch rounded ring-1 shadow-(--shadow-sm)',
    'ring-(--border) bg-(--bg-subtle)',
    'transition-shadow duration-(--duration)'
  ].join(" "),

  actionGroup: [
    'flex items-center gap-1.5 text-button-13 md:text-button-14',
    'hover:bg-(--bg-muted)',
    'cursor-pointer select-none'
  ].join(" "),

  actionDivider: "h-px bg-(--border) my-1.5 mx-1",

  actionIcon: [
    'relative inline-flex items-center justify-center shrink-0',
    'size-4',
  ].join(" "),

  actionDropdown: [
    'absolute right-0 top-[calc(100%+0.5rem)] min-w-[12rem] z-50 rounded-md ring-1 p-1',
    'ring-(--border) bg-(--bg-subtle) shadow-(--shadow-lg)',
    'animate-in fade-in slide-in-from-top-2 origin-top-right',
  ].join(" "),

  actionDropdownItems: [
    'flex items-center gap-2 p-2 text-button-13 md:text-button-14 text-start rounded w-full',
    'text-(--fg) hover:bg-(--bg-muted) hover:text-(--fg-strong)',
    'cursor-pointer'
  ].join(" "),
};

const ACTION = {
  copy: [
    { action: "url", icon: "link", message: "Copy as URL" },
    { action: "markdown", icon: "file", message: "Copy as Markdown" },
    { action: "agent", icon: "ai-agent", message: "Open in Agent"}
  ],
};
---

<div class:list={[s.wrapper, className]}>
  <template class="raw-markdown-data">{rawMarkdown}</template>
  
  <button 
    type="button"
    data-action="copy-default" 
    aria-label="Copy page URL" 
    class:list={[
      "px-2.5 py-2 rounded-l",
      s.actionGroup
    ]}
  >
    <div class={s.actionIcon}>
      <Icon name="copy" class="icon-copy w-full h-full text-(--fg-strong)" />
      <Icon name="check" class="icon-check w-full h-full hidden absolute inset-0 text-(--accent) transition-opacity duration-(--duration)" />
    </div>
    <span>{label}</span>
  </button>

  <details 
    id={uniqueId}
    data-auto-close 
    class="relative group"
  >
    <summary class:list={[
      "px-2.5 py-2 rounded-r border-l border-(--border) h-full",
      "list-none flex items-center justify-center",
      s.actionGroup
    ]}>
      <div class={s.actionIcon}>
        <Icon name="chevron-down" class="w-full h-full text-(--fg-strong) group-open:rotate-180 transition-transform" />
      </div>
    </summary>

    <menu class={s.actionDropdown}>
      {ACTION.copy.map((item, i) => (
      <>
        {item.action === "agent" && (
          <li role="separator" class={s.actionDivider}></li>
        )}
        <li>
          <button
            type="button"
            data-action={item.action}
            class={s.actionDropdownItems}>
            <Icon name={item.icon as any} class={s.actionIcon} />
            {item.message}
          </button>
        </li>
      </>
      ))}
    </menu>
  </details>
</div>

<script>
  function setupCopyButton() {
    document.querySelectorAll('.copy-dropdown-wrapper').forEach(wrapper => {
      const primaryBtn = wrapper.querySelector('[data-action="copy-default"]');
      const details = wrapper.querySelector('details');
      const iconCopy = wrapper.querySelector('.icon-copy');
      const iconCheck = wrapper.querySelector('.icon-check');
      const template = wrapper.querySelector('.raw-markdown-data');

      if (!primaryBtn || !details) return;

      const showCheckmark = () => {
        iconCopy?.classList.add('hidden');
        iconCheck?.classList.remove('hidden');
        setTimeout(() => {
          iconCopy?.classList.remove('hidden');
          iconCheck?.classList.add('hidden');
        }, 2000);
      };

      primaryBtn.addEventListener('click', async () => {
        await navigator.clipboard.writeText(window.location.href);
        showCheckmark();
      });

      details.querySelectorAll('button[data-action]').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const action = (e.currentTarget as HTMLElement).getAttribute('data-action');
          
          details.removeAttribute('open');

          if (action === 'url') {
            await navigator.clipboard.writeText(window.location.href);
            showCheckmark();
          } 
          else if (action === 'markdown') {
            const rawContent = template?.innerHTML || "";
            if (rawContent) {
              await navigator.clipboard.writeText(rawContent);
              showCheckmark();
            }
          } 
          else if (action === 'agent') {
            const drawerTrigger = document.querySelector('[data-drawer-trigger="ai-assistant-drawer"]');
            
            if (drawerTrigger) {
              (drawerTrigger as HTMLElement).click();

              setTimeout(() => {
                const aiInput = document.getElementById('ai-drawer-input') as HTMLInputElement;
                if (aiInput) {
                  aiInput.value = `Tolong jelaskan atau rangkum halaman ini: ${window.location.href}`;
                  aiInput.focus();
                }
              }, 300);
            } else {
              window.location.href = `/agent?page=${window.location.pathname}`;
            }
          }
        });
      });
    });

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      
      document.querySelectorAll('details[data-auto-close][open]').forEach(details => {
        const hasValidId = details.hasAttribute('id');
        
        const isClickOutside = !details.contains(target);

        if (hasValidId && isClickOutside) {
          details.removeAttribute('open');
        }
      });
    });
  }

  setupCopyButton();
</script>