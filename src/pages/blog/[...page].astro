---
// src/pages/blog/[...page].astro

import { getCollection } from "astro:content";
import {
  SITE,
  PAGINATION,
  buildMeta,
  schemaWebPage,
  schemaBreadcrumb,
ROUTES
} from "@/consts";

import Layout from "@/layouts/Layout.astro";
import Container from "@ui/Container.astro";
import Section from "@ui/Section.astro";
import BlogHero from "@/components/blog/BlogHero.astro";
import BlogCard from "@/components/blog/BlogCard.astro";
import Pagination from "@/components/Pagination.astro";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");

  const publishedPosts = allPosts
    .filter((post) => !post.data.draft)
    .sort(
      (a, b) =>
        (b.data.pubDate?.getTime() ?? 0) -
        (a.data.pubDate?.getTime() ?? 0)
    );

  const totalPosts = publishedPosts.length;
  const totalPages = Math.ceil(totalPosts / PAGINATION.postsPerPage);

  const paths = [];

  for (let page = 1; page <= totalPages; page++) {
    const start = (page - 1) * PAGINATION.postsPerPage;
    const end = start + PAGINATION.postsPerPage;
    const postsForThisPage = publishedPosts.slice(start, end);
    const params = { page: page === 1 ? undefined : String(page) };

    paths.push({
      params,
      props: {
        posts: postsForThisPage,
        currentPage: page,
        totalPages,
        featuredPosts: publishedPosts.slice(0, 3),
      },
    });
  }

  return paths;
}

const { 
  posts: pagePosts, 
  currentPage, 
  totalPages, 
  featuredPosts 
} = Astro.props;

const displayPosts = currentPage === 1 ? pagePosts.slice(3) : pagePosts;

const currentUrl = currentPage === 1
  ? `${SITE.url}${ROUTES.blog}/`
  : `${SITE.url}${ROUTES.blog}/${currentPage}`;

const blog = {
  title: "Blog",
  description: "Latest articles, tutorials and updates."
}

const meta = buildMeta({
  ...blog,
  canonical: currentUrl
});

const schema = [ 
  schemaWebPage({
    ...blog,
    url: currentUrl,
    type: "CollectionPage",
    
  }),
  schemaBreadcrumb([
    { name: "Beranda", url: `${SITE.url}${ROUTES.home}` },
    { name: "Blog", url: `${SITE.url}${ROUTES.blog}/` },
  ])
];
---

<Layout meta={meta} schema={schema}>
  <Section size="md">
    <Container size="lg">
      <Section size="none" class="pb-4 md:pb-6">
        <BlogHero {...blog} />
      </Section>
    </Container>
    <Section size="sm">
      <Container size="lg">
        {currentPage === 1 && featuredPosts && featuredPosts.length > 0 && (
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 mb-12">
            {featuredPosts.map((post, index) => (
              <BlogCard entry={post} index={index} />
            ))}
          </div>
        )}
      </Container>
      <Container size="lg">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {displayPosts.map((post, index) => {
            const cleanPostData = {
              ...post,
              data: {
                ...post.data,
                cover: undefined
              }
            };
            
            return <BlogCard entry={cleanPostData} index={index + 3} />;
          })}
        </div>
      </Container>
      <Container size="lg">
        {totalPages > 1 && (
          <div class="mt-10">
            <Pagination
              currentPage={currentPage}
              totalPages={totalPages}
              href={(page) =>
                page === 1 ? `${ROUTES.blog}/` : `${ROUTES.blog}/${page}/`
              }
            />
          </div>
        )}
      </Container>
    </Section>
  </Section>
</Layout>
