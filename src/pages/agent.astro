---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import Icons from "@/components/ui/Icons.astro";
import { SITE, buildMeta } from "@/consts";

const pageParam = Astro.url.searchParams.get("page") || "";

const meta = buildMeta({
  title: "AI Agent",
  description: "Eksplorasi dokumentasi, artikel, dan kode teknikal Codocs lewat obrolan AI.",
  canonical: `${SITE.url}/agent`,
  noindex: true,
});
---

<Layout meta="{meta}">
  {/* Memuat Markdown Parser Ringan */}
  <script is:inline src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

  <main class="max-w-3xl mx-auto px-4 py-8 h-[calc(100vh-4rem)] flex flex-col">
    <!-- Header Halaman Agent -->
    <div class="mb-4 pb-4 border-b border-(--border-subtle) shrink-0">
      <div class="flex items-center gap-3">
        <div class="relative flex size-10 items-center justify-center rounded-xl bg-(--bg-subtle) border border-(--border-subtle) text-(--fg-strong) shadow-sm">
          <span class="absolute inset-0 rounded-xl bg-(--accent) opacity-10 blur-md"></span>
          <Icons class="relative size-5 text-(--accent)" name="ai-agent"/>
        </div>
        <div>
          <h1 class="text-heading-18 font-bold text-(--fg-strong) tracking-tight">Codocs AI Assistant</h1>
          <p class="text-sm text-(--fg-muted)">Eksplorasi dokumentasi dan kode lewat obrolan cerdas.</p>
        </div>
      </div>
      {pageParam && (
        <div class="mt-4 inline-flex items-center gap-2 px-3 py-1.5 text-xs rounded-lg bg-(--bg-muted)/50 border border-(--border-subtle) text-(--fg-muted)">
          <Icons class="size-3" name="link"/>
          <span>Konteks aktif:</span>
          <code class="text-(--fg-strong) font-mono">{pageParam}</code>
        </div>
      )}
    </div>

    <!-- Chat Container -->
    <div id="agent-chat-container" class="agent-scroll flex-1 overflow-y-auto space-y-5 pb-4 pr-2">
      <!-- Pesan Selamat Datang -->
      <div class="flex gap-3 items-start agent-msg-in">
        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-b from-(--bg-subtle) to-(--bg-muted) border border-(--border-subtle) text-(--fg-strong) shadow-sm">
          <Icons class="size-4 text-(--accent)" name="ai-agent"/>
        </div>
        <div class="p-4 rounded-2xl rounded-tl-sm bg-(--bg-subtle) border border-(--border-subtle) text-(--fg-muted) max-w-[85%] text-sm leading-relaxed shadow-sm">
          Halo! Saya adalah AI Agent Anda. Silakan ajukan pertanyaan atau minta rangkuman mengenai materi teknikal di situs ini.
        </div>
      </div>
    </div>

    <!-- Form Input Bar -->
    <div class="shrink-0 pt-4 pb-safe border-t border-(--border-subtle) bg-(--bg)">
      <div class="flex items-end gap-2 relative">
        <textarea
          id="agent-input"
          rows="1"
          placeholder="Tanyakan sesuatu tentang dokumentasi ini..."
          class="flex-1 resize-none rounded-xl border border-(--border-subtle) bg-(--bg-subtle) px-4 py-3 text-sm text-(--fg-strong) placeholder:text-(--fg-muted)/70 outline-none transition-all focus:border-(--accent) focus:ring-2 focus:ring-(--accent)/20 shadow-sm"
          style="max-height: 120px;"
        ></textarea>
        <Button aria-label="Kirim pertanyaan" class="agent-send-btn shrink-0 mb-0.5 rounded-xl h-11 w-11 p-0 flex items-center justify-center" disabled id="agent-submit" size="md" thisIcon variant="primary">
          <Icons class="agent-send-icon size-5" name="arrow-up"/>
          <span class="agent-send-spinner"></span>
        </Button>
      </div>
      <p class="text-[11px] text-center text-(--fg-muted) mt-3">
        AI dapat membuat kesalahan. Harap verifikasi kode dan informasi teknikal.
      </p>
    </div>
  </main>
</Layout>

<!-- TEMPLATES -->
<template id="template-msg-user">
  <div class="flex gap-3 justify-end items-start agent-msg-in">
    <div class="p-3.5 px-4 rounded-2xl rounded-tr-sm bg-(--accent) text-(--accent-fg) max-w-[85%] text-sm whitespace-pre-wrap leading-relaxed shadow-sm"></div>
  </div>
</template>

<template id="template-msg-ai">
  <div class="flex gap-3 justify-start items-start agent-msg-in group">
    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-b from-(--bg-subtle) to-(--bg-muted) border border-(--border-subtle) text-(--fg-strong) shadow-sm">
      <Icons class="size-4 text-(--accent)" name="ai-agent"/>
    </div>
    <div class="relative max-w-[85%] w-full">
      <!-- Container untuk Markdown -->
      <div data-ai-text class="agent-markdown p-4 rounded-2xl rounded-tl-sm bg-(--bg-subtle) border border-(--border-subtle) text-(--fg-strong) text-sm shadow-sm overflow-x-auto"></div>
      
      <button
        data-ai-copy
        type="button"
        aria-label="Salin jawaban"
        class="absolute -bottom-3 right-2 opacity-0 group-hover:opacity-100 transition-all duration-200 flex items-center gap-1.5 px-2 py-1 bg-(--bg-subtle) border border-(--border) rounded-md text-xs font-medium text-(--fg-muted) hover:text-(--fg-strong) hover:bg-(--bg-muted) shadow-sm"
      >
        <Icons class="size-3" name="copy"/>
        <span class="copy-label">Copy</span>
      </button>
    </div>
  </div>
</template>

<template id="template-msg-typing">
  <div class="flex gap-3 justify-start items-start agent-msg-in">
    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-(--bg-subtle) border border-(--border-subtle) text-(--fg-strong) shadow-sm">
      <Icons class="size-4 text-(--accent)" name="ai-agent"/>
    </div>
    <div class="agent-typing px-4 py-4 rounded-2xl rounded-tl-sm bg-(--bg-subtle) border border-(--border-subtle) shadow-sm">
      <span></span><span></span><span></span>
    </div>
  </div>
</template>

<style is:global>
  /* Kustomisasi gaya Markdown AI agar rapi tanpa plugin Typography */
  .agent-markdown {
    line-height: 1.6;
  }
  .agent-markdown p {
    margin-bottom: 1em;
  }
  .agent-markdown p:last-child {
    margin-bottom: 0;
  }
  .agent-markdown pre {
    background-color: var(--bg);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 12px;
    margin: 1em 0;
    overflow-x: auto;
    font-size: 0.85em;
  }
  .agent-markdown code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    background-color: var(--bg-muted);
    padding: 2px 4px;
    border-radius: 4px;
    font-size: 0.9em;
  }
  .agent-markdown pre code {
    background-color: transparent;
    padding: 0;
  }
  .agent-markdown ul {
    list-style-type: disc;
    padding-left: 1.5em;
    margin-bottom: 1em;
  }
  .agent-markdown ol {
    list-style-type: decimal;
    padding-left: 1.5em;
    margin-bottom: 1em;
  }
  .agent-markdown strong {
    font-weight: 600;
    color: var(--fg-strong);
  }

  /* Animasi bawaan */
  .agent-scroll {
    scroll-behavior: smooth;
    scrollbar-width: thin;
  }
  @keyframes agent-msg-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .agent-msg-in {
    animation: agent-msg-in 0.3s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .agent-typing {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .agent-typing span {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--fg-muted);
    animation: agent-typing-bounce 1.4s infinite ease-in-out both;
  }
  .agent-typing span:nth-child(1) { animation-delay: -0.32s; }
  .agent-typing span:nth-child(2) { animation-delay: -0.16s; }
  
  @keyframes agent-typing-bounce {
    0%, 80%, 100% { transform: scale(0); opacity: 0.5; }
    40% { transform: scale(1); opacity: 1; }
  }

  /* Spinner Tombol Send */
  .agent-send-btn { position: relative; }
  .agent-send-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .agent-send-spinner {
    display: none;
    position: absolute;
    inset: 0;
    margin: auto;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    border: 2px solid color-mix(in srgb, var(--bg) 30%, transparent);
    border-top-color: var(--bg);
  }
  .agent-send-btn.is-loading .agent-send-icon { opacity: 0; }
  .agent-send-btn.is-loading .agent-send-spinner {
    display: block;
    animation: agent-spin 0.8s linear infinite;
  }
  @keyframes agent-spin { to { transform: rotate(360deg); } }
</style>

<script>
  // Konfigurasi marked.js untuk mendukung line breaks
  if (typeof window.marked !== 'undefined') {
    window.marked.setOptions({
      breaks: true,
      gfm: true
    });
  }

  const submitBtn = document.getElementById('agent-submit') as HTMLButtonElement;
  const inputEl = document.getElementById('agent-input') as HTMLTextAreaElement;
  const chatContainer = document.getElementById('agent-chat-container');

  const tmplUser = document.getElementById('template-msg-user') as HTMLTemplateElement;
  const tmplAi = document.getElementById('template-msg-ai') as HTMLTemplateElement;
  const tmplTyping = document.getElementById('template-msg-typing') as HTMLTemplateElement;

  function scrollToBottom() {
    requestAnimationFrame(() => {
      chatContainer?.scrollTo({ top: chatContainer.scrollHeight, behavior: 'smooth' });
    });
  }

  function appendUserMessage(text: string) {
    const clone = tmplUser.content.cloneNode(true) as DocumentFragment;
    const bubble = clone.querySelector('div > div') as HTMLElement;
    if (bubble) bubble.textContent = text;
    chatContainer?.appendChild(clone);
    scrollToBottom();
  }

  function appendTypingIndicator() {
    const clone = tmplTyping.content.cloneNode(true) as DocumentFragment;
    const node = clone.firstElementChild as HTMLElement;
    chatContainer?.appendChild(clone);
    scrollToBottom();
    return node;
  }

  function appendAiMessage(text: string, isError = false) {
    const clone = tmplAi.content.cloneNode(true) as DocumentFragment;
    const bubble = clone.querySelector('[data-ai-text]') as HTMLElement;
    const copyBtn = clone.querySelector('[data-ai-copy]') as HTMLButtonElement;
    const copyLabel = clone.querySelector('.copy-label') as HTMLSpanElement;

    if (bubble) {
      if (isError) {
        bubble.textContent = text;
        bubble.classList.add('text-red-500');
      } else {
        // Render Markdown ke HTML
        bubble.innerHTML = window.marked ? window.marked.parse(text) : text;
      }
    }

    if (copyBtn) {
      if (isError) {
        copyBtn.remove();
      } else {
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(text);
            copyLabel.textContent = 'Copied!';
            copyBtn.classList.add('text-(--accent)');
            setTimeout(() => {
              copyLabel.textContent = 'Copy';
              copyBtn.classList.remove('text-(--accent)');
            }, 2000);
          } catch {}
        });
      }
    }

    chatContainer?.appendChild(clone);
    scrollToBottom();
  }

  function autosize() {
    inputEl.style.height = 'auto';
    inputEl.style.height = `${Math.min(inputEl.scrollHeight, 120)}px`;
  }

  function updateSendState() {
    submitBtn.disabled = inputEl.value.trim().length === 0;
  }

  function setLoading(loading: boolean) {
    submitBtn.classList.toggle('is-loading', loading);
    submitBtn.disabled = loading || inputEl.value.trim().length === 0;
    inputEl.disabled = loading;
  }

  window.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const pageTarget = urlParams.get('page');
    
    // Auto trigger pertanyaan pertama jika dari Docs
    if (pageTarget && inputEl) {
      inputEl.value = `Tolong jelaskan secara singkat isi dari halaman ${pageTarget}`;
      autosize();
      updateSendState();
    }
  });

  async function handleAgentAsk() {
    const question = inputEl.value.trim();
    if (!question) return;

    inputEl.value = '';
    autosize();
    updateSendState();
    setLoading(true);

    appendUserMessage(question);
    const typingNode = appendTypingIndicator();

    // 1. Prioritaskan sessionStorage (teks markdown)
    // 2. Fallback ke teks dari halaman ini
    const contextStr = sessionStorage.getItem('ai-context') || document.querySelector('article')?.innerText || window.location.pathname;

    try {
      const res = await fetch('/api/ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question, context: contextStr }),
      });
      const data = await res.json();
      typingNode?.remove();
      appendAiMessage(data.answer || 'Maaf, saya tidak bisa merespons saat ini.');
    } catch {
      typingNode?.remove();
      appendAiMessage('Gagal menghubungi server AI. Pastikan koneksi internet Anda stabil.', true);
    } finally {
      setLoading(false);
      // Opsional: hapus context setelah selesai fetch pertama agar tidak terus terbawa
      // sessionStorage.removeItem('ai-context');
      
      // Kembalikan fokus ke input (hanya untuk desktop agar keyboard HP tidak terus pop-up)
      if (window.innerWidth > 768) {
        inputEl?.focus();
      }
    }
  }

  submitBtn?.addEventListener('click', handleAgentAsk);
  inputEl?.addEventListener('input', () => {
    autosize();
    updateSendState();
  });
  inputEl?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleAgentAsk();
    }
  });
</script>