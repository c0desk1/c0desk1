---
// src/pages/[slug].astro
// Menangani semua halaman legal dari content/legal/

import { 
  getCollection, 
  render 
} from "astro:content";

import { 
  buildMeta, 
  IMAGE, 
  schemaWebPage,
  schemaBreadcrumb,
  ROUTES,
  SITE 
} from "@/consts";

import { formatDate } from '@lib/utils';
import { components } from "@/components/mdx/MDXComponents";

import Layout from "@/layouts/Layout.astro";
import Section from "@ui/Section.astro";
import Container from "@ui/Container.astro";

export async function getStaticPaths() {
  const legalEntries = await getCollection("legal", ({ data }) => !data.seo?.noIndex);
  
  return legalEntries.map((entry) => ({
    params: { slug: entry.data.slug || entry.id.replace(/\.(md|mdx)$/, '') },
    props: { entry },
    cacheKey: (entry as any).digest
  }));
}

const { entry } = Astro.props;

if (!entry) {
  return Astro.redirect("/404/");
}

const { Content } = await render(entry);

const currentSlug = entry.data.slug || entry.id.replace(/\.(md|mdx)$/, '');
const baseUrl = SITE.url.replace(/\/$/, "");
const currentUrl = `${baseUrl}/${currentSlug}/`;

let legalPageType: "PrivacyPolicy" | "TermsOfService" | "WebPage" = "WebPage";

if (currentSlug.includes("privacy")) {
  legalPageType = "PrivacyPolicy";
} else if (currentSlug.includes("terms") || currentSlug.includes("service")) {
  legalPageType = "TermsOfService";
}

const breadcrumbName = entry.data.title;

const metaDescription = entry.data.seo?.description 
  ?? entry.data.description 
  ?? `Baca ${entry.data.title} lengkap di ${SITE.name}.`;


const keywords = [
  entry.data.title.toLowerCase(),
  ...(currentSlug.includes("privacy") ? ["privasi", "data", "perlindungan"] : []),
  ...(currentSlug.includes("terms") ? ["syarat", "ketentuan", "layanan"] : []),
  ...(currentSlug.includes("cookie") ? ["cookie", "kebijakan"] : []),
];

const metaProps = buildMeta({
  title: entry.data.seo?.title || entry.data.title,
  description: metaDescription,
  canonical: currentUrl,
  noindex: entry.data.seo?.noIndex ?? false,
  keywords: keywords,
});

const pageSchema = [
  schemaWebPage({
    title: entry.data.title,
    description: entry.data.description || SITE.description,
    url: currentUrl,
    type: legalPageType,
    dateModified: entry.data.lastUpdated?.toISOString(),
    image: {
      url: SITE.logo.startsWith('http') 
        ? SITE.logo 
        : `${baseUrl}${SITE.logo}`,
      width: IMAGE.logo.width,
      height: IMAGE.logo.height,
      caption: entry.data.title
    }
  }),
  schemaBreadcrumb([
    { name: "Beranda", url: `${baseUrl}${ROUTES.home}` },
    { name: breadcrumbName, url: currentUrl },
  ]),
];

const $ = {
  main: "w-full min-w-0 flex-1",
  divider: "bg-none border-t border-dashed border-(--border-subtle)/80 my-6 md:my-8",
  header: "mb-6 md:mb-8",
  title: "mb-4 text-heading-32 md:text-heading-40 lg:text-heading-48 font-semibold text-(--fg-strong)",
  meta: "justify-center items-center gap-4 space-y-2 text-sm text-(--fg-muted)",
  description: "text-sm text-(--fg-muted)"
}
---

<Layout meta={metaProps} schema={pageSchema}>
  <div data-pagefind-weight="1" class="hidden" />
  <main id="main-content" class={$.main}>
    <article data-pagefind-body data-pagefind-filter="type:legal">
      <Section size="lg">
        <Container size="md">
          <header data-pagefind-ignore class={$.header}>
            <h1 data-pagefind-meta="title" class={$.title}>
              {entry.data.title}
            </h1>
            <div class={$.meta}>
              {entry.data.lastUpdated && (
                <p>
                  <time 
                    data-pagefind-meta="date" 
                    data-pagefind-sort="date" 
                    datetime={entry.data.lastUpdated.toISOString()}
                  >
                    Terakhir diperbarui: {formatDate(entry.data.lastUpdated)}
                  </time>
                </p>
              )}
              <p data-pagefind-meta="description" class={$.description}>
                {entry.data.description}
              </p>
            </div>
          </header>
        </Container>
        <div class={$.divider} />
        <Container size="md">
          <div class="prose">
            <Content components={components} />
          </div>
        </Container>
      </Section>
    </article>
  </main>
</Layout>
