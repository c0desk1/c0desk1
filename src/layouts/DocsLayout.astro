---
// src/layouts/DocsLayout.astro
import Layout from "./Layout.astro";
import DocsNavbar from "@docs/DocsNavbar.astro";
import DocsNavigation from "@docs/DocsNavigation.astro"; 
import PageFrame from "@/components/PageFrame.astro";
import Sidebar from "@ui/Sidebar.astro";
import MobileHeader from "@/components/MobileHeader.astro";
import ScrollToTop from "@docs/mobile/ScrollToTop.astro";
import Card from "@ui/Card.astro";
import Socials from "@/components/Socials.astro";
import Theme from "@/components/Theme.astro";

import { type buildMeta as BuildMetaFn } from "@/consts";

interface Props {
  meta?: Partial<ReturnType<typeof BuildMetaFn>>;
  schema?: object | object[];
  isHome?: boolean;
  canonical?: string;
  author?: string;
  publisher?: string;
}

const { 
  meta, 
  schema, 
  isHome = false, 
  canonical,
  author,
  publisher,
} = Astro.props;
---
<Layout 
  hideHeader 
  {meta} 
  {schema} 
  {isHome} 
  {canonical}
  {author}
  {publisher}
>
  <MobileHeader>
    <DocsNavbar />
    <div class="flex-1 overflow-y-auto mb-0 scrollbar-hide">
      <DocsNavigation />
    </div>
    <Card padding="xs" radius="sm" variant="secondary" class="flex md:hidden items-center justify-between mt-4">
      <div class="flex items-center">
        <Socials />
      </div>
      <Theme />
    </Card>
  </MobileHeader>
  <PageFrame>
    <aside 
      aria-label="Main Navigation"
      class="hidden lg:block sticky top-(--header-height) h-[calc(100vh-var(--header-height))] w-full bg-(--bg) border-r border-(--border-subtle) rounded-none"
    >
      <Sidebar>
        <DocsNavbar />
        <DocsNavigation />
      </Sidebar>
    </aside>
    <main id="main-content" class="w-full min-w-0 flex-1">
      <slot />
    </main>
    <aside 
      aria-label="Table of Contents"
      class="hidden lg:block sticky top-(--header-height) h-[calc(100vh-var(--header-height))] w-full overflow-y-auto px-2 pt-4 pb-(--safe-bottom)"
    >
      <slot name="right" />
    </aside>
  </PageFrame>
  
  <ScrollToTop />
</Layout>
