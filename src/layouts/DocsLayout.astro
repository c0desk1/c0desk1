---
// src/layouts/DocsLayout.astro
import Layout from "./Layout.astro";
import DocsNavbar from "@docs/DocsNavbar.astro";
import DocsNavbarMobile from "@docs/DocsNavbar.astro";
import DocsNavigation from "@docs/DocsNavigation.astro"; 
import PageFrame from "@/components/PageFrame.astro";
import Sidebar from "@ui/Sidebar.astro";
import MobileHeader from "@/components/MobileHeader.astro";
import ScrollToTop from "@docs/mobile/ScrollToTop.astro";
import Card from "@ui/Card.astro";
import Socials from "@/components/Socials.astro";
import Theme from "@/components/Theme.astro";
import { type buildMeta as BuildMetaFn } from "@/consts";

interface Props {
  meta?: Partial<ReturnType<typeof BuildMetaFn>>;
  schema?: object | object[];
  isHome?: boolean;
  canonical?: string;
  author?: string;
  publisher?: string;
}

const { 
  meta, 
  schema, 
  isHome = false, 
  canonical,
  author,
  publisher,
} = Astro.props;
---
<Layout 
  hideHeader 
  {meta} 
  {schema} 
  {isHome} 
  {canonical}
  {author}
  {publisher}
>
  <MobileHeader>
    <DocsNavbarMobile />
    <div class="flex-1 overflow-y-auto mb-0 scrollbar-hide">
      <DocsNavigation />
    </div>
    <Card padding="xs" radius="sm" class="flex md:hidden items-center justify-between">
      <div class="flex items-center">
        <Socials />
      </div>
      <Theme />
    </Card>
  </MobileHeader>
  <PageFrame>
    <aside class="bg-(--bg) rounded-none border-r border-(--border-subtle)/80 hidden sticky top-[calc(var(--header-height))] lg:block h-[calc(100vh)] w-full">
      <Sidebar>
        <DocsNavbar />
        <div class="flex-1 overflow-y-auto">
          <DocsNavigation />
        </div>
      </Sidebar>
    </aside>
    <main id="main-content" class="w-full min-w-0 flex-1">
      <slot />
    </main>
    <aside class="hidden sticky top-(--header-height) lg:block lg:h-[calc(100vh-var(--header-height))] overflow-y-auto px-2 pt-4 pb-(--safe-bottom) w-full">
      <slot name="right" />
    </aside>
  </PageFrame>
  <ScrollToTop />
</Layout>