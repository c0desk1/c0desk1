---
// src/layouts/DocsLayout.astro
import Layout from "./Layout.astro"; 
import PageFrame from "@/components/PageFrame.astro";
import MobileHeader from "@/components/MobileHeader.astro";
import ScrollToTop from "@docs/mobile/ScrollToTop.astro";
import LeftSidebar from "@/components/docs/LeftSidebar.astro";

import { type buildMeta as BuildMetaFn } from "@/consts";

interface Props {
  meta?: Partial<ReturnType<typeof BuildMetaFn>>;
  schema?: object | object[];
  isHome?: boolean;
  canonical?: string;
  author?: string;
  publisher?: string;
}

const { 
  meta, 
  schema, 
  isHome = false, 
  canonical,
  author,
  publisher,
} = Astro.props;
---
<Layout 
  hideHeader 
  {meta} 
  {schema} 
  {isHome} 
  {canonical}
  {author}
  {publisher}
>
  <MobileHeader />
  <PageFrame>
    <LeftSidebar />
    <main id="main-content" class="w-full min-w-0 flex-1">
      <slot />
    </main>
    <aside 
      aria-label="Table of Contents"
      class="hidden lg:block sticky top-(--header-height) h-[calc(100vh-var(--header-height))] w-full overflow-y-auto px-4 py-4 pb-(--safe-bottom) border-l border-(--border-subtle) scrollbar-gutter-stable"
    >
      <slot name="right" />
    </aside>
  </PageFrame>
  <ScrollToTop />
</Layout>
